---
/**
 * 邊緣裝置評測長條圖。每個模型一列，依量化位元數各畫一條。
 * 長條以 CSS 變數 --w 設定寬度，捲動進畫面時由 global.css 的 .bar 動畫長出。
 */
import { benchmark, bits } from '../data/benchmark';

interface Props {
  metric: 'tokPerSec' | 'mmlu';
  title: string;
  unit: string;
  /** 刻度上限，讓兩個圖表各自有合適的比例 */
  max: number;
}
const { metric, title, unit, max } = Astro.props;
const shades = ['var(--signal)', 'color-mix(in srgb, var(--signal) 58%, var(--void))', 'color-mix(in srgb, var(--signal) 28%, var(--void))'];
---

<figure class="card p-7">
  <figcaption class="flex flex-wrap items-baseline justify-between gap-3">
    <span class="text-lg" style="font-family: var(--font-display)">{title}</span>
    <span class="flex flex-wrap gap-4 text-xs" style="color: var(--ink-faint)">
      {
        bits.map((b, i) => (
          <span class="inline-flex items-center gap-1.5">
            <span class="inline-block size-2.5 rounded-full" style={`background:${shades[i]}`} />
            {b}
          </span>
        ))
      }
    </span>
  </figcaption>

  <dl class="mt-6 space-y-5">
    {
      benchmark.map((row) => (
        <div class="grid grid-cols-[3rem_1fr] items-center gap-4">
          <dt class="reading text-sm font-medium">{row.model}</dt>
          <dd class="space-y-1.5">
            {row[metric].map((v, i) =>
              v === null ? null : (
                <div class="flex items-center gap-3">
                  <div class="h-2.5 flex-1 overflow-hidden rounded-full" style="background: var(--surface-2)">
                    <div class="bar rounded-full" style={`--w:${(v / max) * 100}%; background:${shades[i]}`} />
                  </div>
                  <span class="reading w-16 shrink-0 text-right text-xs" style="color: var(--ink-soft)">
                    {metric === 'mmlu' && row.approx?.mmlu?.includes(i) ? '約 ' : ''}
                    {v}
                    {unit}
                  </span>
                </div>
              ),
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</figure>
