---
import { site, nav } from '../config/site';
---

<footer class="border-t" style="border-color: var(--border); background: var(--bg-subtle)">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div class="max-w-sm">
        <div class="flex items-center gap-2.5">
          <img src="/news/images/favicon.png" alt="" width="32" height="32" class="size-8 rounded-lg" />
          <span class="text-base font-bold">{site.shortName}</span>
        </div>
        <p class="mt-3 text-sm leading-relaxed" style="color: var(--ink-muted)">{site.tagline}</p>
        <p class="mt-1 text-sm" style="color: var(--ink-faint)">{site.org}</p>
        <p class="mt-4 inline-block rounded-md px-2 py-1 text-xs" style="background: var(--accent-soft); color: var(--accent)">
          {site.funding}
        </p>
      </div>

      <nav aria-label="頁尾導覽">
        <h2 class="text-xs font-bold tracking-widest uppercase" style="color: var(--ink-faint)">網站導覽</h2>
        <ul class="mt-4 grid grid-cols-2 gap-x-10 gap-y-2.5 sm:grid-cols-3 md:grid-cols-2">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="text-sm hover:underline" style="color: var(--ink-muted)">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/news/post/quiz.html" class="text-sm hover:underline" style="color: var(--ink-muted)">
              AI 小測驗
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <p class="mt-10 border-t pt-6 text-xs" style="border-color: var(--border); color: var(--ink-faint)">
      {site.copyright}
    </p>
  </div>
</footer>
