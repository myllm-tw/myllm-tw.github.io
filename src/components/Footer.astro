---
import { site, nav } from '../config/site';
---

<footer class="border-t" style="border-color: var(--rule)">
  <div class="mx-auto max-w-5xl px-5 py-16">
    <div class="flex flex-col gap-12 md:flex-row md:justify-between">
      <div class="max-w-xs">
        <p style="font-family: var(--font-display)" class="text-lg font-bold">{site.shortName}</p>
        <p class="mt-3 text-sm leading-loose" style="color: var(--ink-soft)">
          {site.tagline}<br />{site.org}
        </p>
        <p class="mt-5 text-sm" style="color: var(--ink-faint)">{site.funding}</p>
      </div>

      <nav aria-label="頁尾導覽">
        <ul class="grid grid-cols-2 gap-x-12 gap-y-3">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="text-sm" style="color: var(--ink-soft)">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/news/post/quiz.html" class="text-sm" style="color: var(--ink-soft)">
              AI 小測驗
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <p class="reading mt-14 border-t pt-6 text-xs" style="border-color: var(--rule); color: var(--ink-faint)">
      {site.copyright}
    </p>
  </div>
</footer>
