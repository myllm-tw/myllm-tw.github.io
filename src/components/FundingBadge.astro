---
/**
 * 國科會補助標示。出現在導覽列、首頁開場與各內頁頁首，讓補助單位在每一頁第一眼就看得到。
 * variant="light" 用在淺色背景，"dark" 用在深藍區塊。
 */
import { Icon } from 'astro-icon/components';
import { site } from '../config/site';

interface Props {
  variant?: 'light' | 'dark';
  /** 是否在後面接主辦單位名稱 */
  withOrg?: boolean;
  /** lg 用在首頁開場與內頁頁首，sm 用在導覽列 */
  size?: 'sm' | 'lg';
  class?: string;
}
const { variant = 'light', withOrg = false, size = 'sm', class: className = '' } = Astro.props;
const lg = size === 'lg';
const dark = variant === 'dark';
---

<span
  class={`inline-flex flex-wrap items-center gap-x-2.5 gap-y-1 ${className}`}
  title={`${site.fundingAgency}補助`}
>
  <span
    class={`inline-flex items-center gap-1.5 rounded-full font-medium ${lg ? 'px-4 py-1.5 text-sm' : 'px-3 py-1 text-xs'}`}
    style={dark
      ? 'background: rgb(217 164 65 / 0.16); color: #f0c46a; box-shadow: inset 0 0 0 1px rgb(217 164 65 / 0.45)'
      : 'background: color-mix(in srgb, var(--signal) 12%, transparent); color: var(--signal); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--signal) 40%, transparent)'}
  >
    <Icon name="lucide:landmark" class={lg ? 'size-4' : 'size-3.5'} aria-hidden="true" />
    {site.funding}
  </span>
  {
    withOrg && (
      <span class={lg ? 'text-[15px]' : 'text-sm'} style={dark ? 'color: #c9d6e3' : 'color: var(--ink-soft)'}>
        {site.org}
      </span>
    )
  }
</span>
