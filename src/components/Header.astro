---
import ThemeToggle from './ThemeToggle.astro';
import Logo from './Logo.astro';
import { Icon } from 'astro-icon/components';
import { site, nav } from '../config/site';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const target = href.replace(/\/$/, '') || '/';
  return pathname === target || pathname.startsWith(`${target}/`);
};
---

<header class="glass sticky top-0 z-40 border-x-0 border-t-0">
  <div class="mx-auto flex h-16 max-w-5xl items-center gap-5 px-5">
    <a href="/" class="flex items-center gap-3" aria-label={`${site.shortName} 首頁`}>
      <Logo height={26} />
      <span class="hidden border-l pl-3 text-xs sm:block" style="color: var(--ink-faint); border-color: var(--rule)">
        {site.tagline}
      </span>
    </a>

    <nav class="ml-auto hidden md:block" aria-label="主要導覽">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="block rounded-full px-4 py-2 text-sm transition-colors duration-200 hover:bg-[var(--surface-2)]"
                style={
                  isCurrent(item.href)
                    ? 'color: var(--ink); background: var(--surface-2); box-shadow: inset 0 1px 0 var(--highlight)'
                    : 'color: var(--ink-soft)'
                }
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1 md:ml-0">
      <ThemeToggle />
      <button
        id="menu-toggle"
        type="button"
        class="grid size-9 place-items-center rounded-full transition-colors hover:bg-[var(--surface-2)] md:hidden"
        style="color: var(--ink-soft)"
        aria-label="開啟選單"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <Icon name="lucide:menu" class="size-5" />
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="hidden border-t md:hidden" style="border-color: var(--rule)" aria-label="主要導覽">
    <ul class="mx-auto max-w-5xl px-5 py-2">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="block border-l-2 py-3 pl-4 text-sm"
              style={
                isCurrent(item.href)
                  ? 'color: var(--ink); border-color: var(--signal)'
                  : 'color: var(--ink-soft); border-color: transparent'
              }
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? '關閉選單' : '開啟選單');
  });
</script>
