---
import ThemeToggle from './ThemeToggle.astro';
import { site, nav } from '../config/site';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const target = href.replace(/\/$/, '') || '/';
  return pathname === target || pathname.startsWith(`${target}/`);
};
---

<header class="sticky top-0 z-40 border-b" style="border-color: var(--rule); background: var(--void)">
  <div class="mx-auto flex h-16 max-w-5xl items-center gap-5 px-5">
    <a href="/" class="flex items-baseline gap-2.5" aria-label={`${site.shortName} 首頁`}>
      <span style="font-family: var(--font-display)" class="text-lg font-bold tracking-tight">
        {site.shortName}
      </span>
      <span class="hidden text-xs sm:block" style="color: var(--ink-faint)">{site.tagline}</span>
    </a>

    <nav class="ml-auto hidden md:block" aria-label="主要導覽">
      <ul class="flex items-center gap-6">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="relative block py-5 text-sm transition-colors"
                style={isCurrent(item.href) ? 'color: var(--ink)' : 'color: var(--ink-soft)'}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
                {isCurrent(item.href) && (
                  <span
                    class="absolute inset-x-0 bottom-0 h-0.5"
                    style="background: var(--signal)"
                    aria-hidden="true"
                  />
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1 md:ml-0">
      <ThemeToggle />
      <button
        id="menu-toggle"
        type="button"
        class="grid size-9 place-items-center md:hidden"
        style="color: var(--ink-soft)"
        aria-label="開啟選單"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M4 8h16M4 16h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="hidden border-t md:hidden" style="border-color: var(--rule)" aria-label="主要導覽">
    <ul class="mx-auto max-w-5xl px-5 py-2">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="block border-l-2 py-3 pl-4 text-sm"
              style={
                isCurrent(item.href)
                  ? 'color: var(--ink); border-color: var(--signal)'
                  : 'color: var(--ink-soft); border-color: transparent'
              }
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? '關閉選單' : '開啟選單');
  });
</script>
