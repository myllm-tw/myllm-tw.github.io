---
interface Props {
  title: string;
  lead?: string;
  /** 右側的圖片，會加上掃描線動效 */
  image?: { src: string; alt: string; width: number; height: number };
  reading?: { label: string; value: string }[];
}
const { title, lead, image, reading = [] } = Astro.props;
---

<section class="inverse relative overflow-hidden">
  <div class="drift halftone pointer-events-none absolute inset-0 opacity-[0.06]" style="color: #e9eff6" aria-hidden="true"></div>
  <div
    class:list={[
      'stage-in relative mx-auto max-w-6xl px-5 py-16 sm:py-20',
      image && 'grid items-center gap-10 md:grid-cols-[1.15fr_1fr] md:gap-14',
    ]}
  >
    <div>
      <h1 class="max-w-2xl text-3xl leading-[1.25] sm:text-4xl md:text-5xl">{title}</h1>
      {lead && <p class="muted mt-7 max-w-xl text-[15px] leading-loose">{lead}</p>}
      {
        reading.length > 0 && (
          <dl class="mt-10 flex flex-wrap gap-x-12 gap-y-6">
            {reading.map((r) => (
              <div>
                <dt class="muted text-sm">{r.label}</dt>
                <dd class="reading mt-1 text-3xl" style="font-family: var(--font-display); color: #d9a441">
                  {r.value}
                </dd>
              </div>
            ))}
          </dl>
        )
      }
      <slot />
    </div>
    {
      image && (
        <div class="scan cut-br">
          <img
            src={image.src}
            alt={image.alt}
            width={image.width}
            height={image.height}
            loading="eager"
            class="block w-full"
          />
        </div>
      )
    }
  </div>
</section>
