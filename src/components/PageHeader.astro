---
interface Props {
  title: string;
  lead?: string;
  /** 右上角的讀數，例如電子報的期數統計 */
  reading?: { label: string; value: string }[];
}
const { title, lead, reading = [] } = Astro.props;
---

<section class="border-b" style="border-color: var(--rule)">
  <div class="mx-auto max-w-5xl px-5 pt-16 pb-14 sm:pt-20">
    <h1 class="max-w-2xl text-3xl leading-[1.3] sm:text-4xl">{title}</h1>
    {
      lead && (
        <p class="mt-7 max-w-xl text-[15px] leading-loose" style="color: var(--ink-soft)">
          {lead}
        </p>
      )
    }
    {
      reading.length > 0 && (
        <dl class="mt-12 flex flex-wrap gap-x-12 gap-y-6">
          {reading.map((r) => (
            <div>
              <dt class="text-sm" style="color: var(--ink-faint)">
                {r.label}
              </dt>
              <dd class="reading mt-1 text-2xl" style="font-family: var(--font-display)">
                {r.value}
              </dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</section>
