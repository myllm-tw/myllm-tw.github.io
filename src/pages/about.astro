---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Card from '../components/Card.astro';
import { site } from '../config/site';
import { services } from '../data/services';
import issues from '../data/newsletter.json';

const totalArticles = issues.reduce((n, i) => n + i.articles.length, 0);

// 只放能從現有資料算出或查證的數字，不要填估計值
const figures = [
  { label: '電子報期數', value: String(issues.length), unit: '期', note: '2023.11 起每月發行' },
  { label: '收錄文章', value: String(totalArticles), unit: '篇', note: 'AI 工具、模型與產業動態' },
  { label: '核心服務', value: String(services.length), unit: '項', note: '從交流到平台設計' },
];
---

<Base
  title="關於聯盟"
  description={`${site.org}於 2024 年 3 月成立 myLLM 產學聯盟，以獨立第三方角色協助產業導入大型語言模型。`}
>
  <PageHeader
    title="以獨立第三方角色，協助產業導入大型語言模型"
    titleEn="About"
    lead={`${site.org}於 2024 年 3 月成立 myLLM 產學聯盟，致力於成為 AI 領域知識使用者與供應者之間的橋樑。`}
  />

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
      <div>
        <h2 class="text-2xl font-bold tracking-tight">聯盟的定位</h2>
        <div class="mt-6 space-y-5 text-[15px] leading-relaxed" style="color: var(--ink-muted)">
          <p>
            AI 技術的供給與需求之間存在落差：企業知道自己有需求，但不容易判斷哪一種模型、哪一套平台真的適合；
            技術供應者則不容易取得中立的效能驗證。
          </p>
          <p>
            聯盟以學術單位的獨立第三方角色介入這個落差，一方面舉辦教育課程、展會與技術交流，
            讓知識流動；一方面提供效能評估與基準測試，讓選擇有依據。
          </p>
          <p>
            在此之上，針對已經確定方向的企業，提供分析式與生成式 AI 平台的設計與落地服務。
          </p>
        </div>
      </div>

      <Card raised>
        <h2 class="text-sm font-bold tracking-widest uppercase" style="color: var(--ink-faint)">主辦單位</h2>
        <p class="mt-4 text-lg font-bold">{site.org}</p>
        <dl class="mt-6 space-y-4 text-sm">
          <div>
            <dt style="color: var(--ink-faint)">成立時間</dt>
            <dd class="mt-1 font-medium">2024 年 3 月</dd>
          </div>
          <div>
            <dt style="color: var(--ink-faint)">計畫類型</dt>
            <dd class="mt-1 font-medium">{site.funding}</dd>
          </div>
          <div>
            <dt style="color: var(--ink-faint)">聯盟角色</dt>
            <dd class="mt-1 font-medium">獨立第三方評測與技術服務</dd>
          </div>
        </dl>
      </Card>
    </div>
  </section>

  <section style="background: var(--bg-subtle)">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-2xl font-bold tracking-tight">聯盟能量</h2>
      <ul class="mt-10 grid gap-5 sm:grid-cols-3">
        {
          figures.map((f) => (
            <li class="rounded-2xl border p-6" style="border-color: var(--border); background: var(--surface)">
              <p class="text-sm font-medium" style="color: var(--ink-muted)">
                {f.label}
              </p>
              <p class="mt-3 flex items-baseline gap-1.5">
                <span class="text-4xl font-bold tracking-tight" style="color: var(--accent)">
                  {f.value}
                </span>
                <span class="text-sm font-medium" style="color: var(--ink-muted)">
                  {f.unit}
                </span>
              </p>
              <p class="mt-3 text-sm" style="color: var(--ink-faint)">
                {f.note}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-2xl font-bold tracking-tight">三個服務方向</h2>
    <ul class="mt-10 space-y-5">
      {
        services.map((s, i) => (
          <li>
            <Card>
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span class="text-xs font-bold tracking-widest" style="color: var(--accent)">
                  {String(i + 1).padStart(2, '0')} · {s.titleEn}
                </span>
                <h3 class="text-lg font-bold">{s.title}</h3>
              </div>
              <p class="mt-4 text-[15px] leading-relaxed" style="color: var(--ink-muted)">
                {s.summary}
              </p>
              <a
                href={`/services/#${s.id}`}
                class="mt-4 inline-block text-sm font-medium hover:underline"
                style="color: var(--accent)"
              >
                看服務細節 →
              </a>
            </Card>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
