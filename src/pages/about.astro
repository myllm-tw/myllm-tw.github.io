---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../config/site';
import { services, edgeLanding, devices } from '../data/services';
import { empowerment } from '../data/empowerment';
import issues from '../data/newsletter.json';

const totalArticles = issues.reduce((n, i) => n + i.articles.length, 0);
const facts = [
  { label: '主辦單位', value: site.org },
  { label: '成立時間', value: '2024 年 3 月' },
  { label: '計畫類型', value: site.funding },
  { label: '聯盟角色', value: '獨立第三方評測與技術服務' },
];
const stats = [
  { value: String(totalArticles), unit: '篇', label: 'AI 電子報文章' },
  { value: String(issues.length), unit: '期', label: '自 2023 年 11 月起每月發行' },
  { value: String(devices.length), unit: '種', label: '嵌入式評測裝置' },
  { value: String(edgeLanding.length), unit: '項', label: 'Edge Landing 落地服務' },
];
---

<Base
  title="關於聯盟"
  description={`${site.org}於 2024 年 3 月成立 myLLM 產學聯盟，以獨立第三方角色協助產業導入大型語言模型。`}
>
  <PageHeader
    title="站在 AI 供給與需求之間的第三方"
    lead={`${site.org}於 2024 年 3 月成立 myLLM 產學聯盟，執行 AI 系統的效能評估，並協助企業把模型帶進自己的環境。`}
    image={{
      src: '/images/services/identity-demo.jpg',
      alt: '聯盟的示範現場：鋼鐵人頭盔旁的樹莓派正在執行即時人臉辨識',
      width: 1600,
      height: 1146,
    }}
  />

  {/* 分割排版：左邊一句大字點題，右邊是說明 */}
  <section class="mx-auto max-w-6xl px-5 py-24">
    <div class="grid gap-12 md:grid-cols-[1fr_1.2fr] md:gap-20">
      <p class="text-3xl leading-snug sm:text-4xl" style="font-family: var(--font-display)">
        企業知道自己需要 AI，<span class="tonal-dim">卻不知道哪一個真的適合。</span>
      </p>
      <div class="space-y-5 text-[15px] leading-loose" style="color: var(--ink-soft)">
        <p>技術供應者也有同樣的困擾：很難取得中立的效能驗證，說服客戶只能靠自己的宣稱。</p>
        <p>
          聯盟以學術單位的身分介入這個落差。一方面舉辦教育課程、展會與技術交流，讓知識流動；一方面提供效能評估與基準測試，讓選擇有依據。
        </p>
        <p>在此之上，為已經確定方向的企業設計並部署分析式與生成式 AI 平台。</p>
      </div>
    </div>

    {/* 基本資料：細線定義列表 */}
    <dl class="grid-rules mt-20 sm:grid-cols-2 lg:grid-cols-4">
      {
        facts.map((f) => (
          <div class="px-1 py-6 sm:px-6">
            <dt class="text-xs" style="color: var(--ink-faint)">
              {f.label}
            </dt>
            <dd class="mt-2 text-[15px] leading-snug">{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {/* 顯性網格數字帶 */}
  <section style="background: var(--surface-2)">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <h2 class="text-3xl sm:text-4xl">聯盟至今累積</h2>
      <dl class="grid-rules on-panel mt-12 grid-cols-2 lg:grid-cols-4">
        {
          stats.map((st) => (
            <div class="flex flex-col justify-between gap-6 px-5 py-8 sm:px-7">
              <dd class="flex items-baseline gap-1.5">
                <span class="reading text-5xl sm:text-6xl" style="font-family: var(--font-display)" data-ticker data-to={st.value}>
                  {st.value}
                </span>
                <span class="text-lg" style="color: var(--signal)">{st.unit}</span>
              </dd>
              <dt class="text-sm" style="color: var(--ink-soft)">
                {st.label}
              </dt>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* 宣言：聯盟的論點 */}
  <section class="top-glow mx-auto max-w-6xl px-5 py-28">
    <p class="relative statement max-w-4xl">
      普通人加上超級工具，<span style="color: var(--signal)">就是企業賦能員工。</span>
    </p>
    <p class="relative mt-8 max-w-xl text-[15px] leading-loose" style="color: var(--ink-soft)">{empowerment.note}</p>
  </section>

  {/* 細線清單：三個服務方向 */}
  <section class="border-t" style="border-color: var(--hairline)">
    <div class="mx-auto max-w-6xl px-5 py-24">
      <h2 class="text-3xl sm:text-4xl">三個服務方向</h2>
      <ol class="hairline-list mt-12">
        {
          services.map((s, i) => (
            <li class="hairline-row">
              <a href={`/services/#${s.id}`} class="grid items-center gap-x-6 gap-y-2 py-7 md:grid-cols-[3rem_1.2fr_1.6fr_1.5rem]">
                <span class="reading text-sm" style="color: var(--signal)">
                  0{i + 1}
                </span>
                <span class="flex items-center gap-3 text-xl" style="font-family: var(--font-display)">
                  <Icon name={s.icon} class="size-5 shrink-0" style="color: var(--signal)" />
                  {s.title}
                </span>
                <span class="text-sm leading-relaxed" style="color: var(--ink-soft)">
                  {s.summary}
                </span>
                <Icon name="lucide:arrow-right" class="row-arrow hidden size-5 md:block" style="color: var(--ink-faint)" />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>
