---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../config/site';
import { services } from '../data/services';
import issues from '../data/newsletter.json';

const totalArticles = issues.reduce((n, i) => n + i.articles.length, 0);
---

<Base
  title="關於聯盟"
  description={`${site.org}於 2024 年 3 月成立 myLLM 產學聯盟，以獨立第三方角色協助產業導入大型語言模型。`}
>
  <PageHeader
    title="站在供給與需求之間的第三方"
    lead={`${site.org}於 2024 年 3 月成立 myLLM 產學聯盟，以獨立第三方角色執行 AI 系統的效能評估，並協助企業把模型帶進自己的環境。`}
  />

  <section class="mx-auto max-w-5xl px-5 py-20">
    <div class="grid gap-16 lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-20">
      <div class="max-w-xl space-y-7 text-[15px] leading-loose" style="color: var(--ink-soft)">
        <p>
          AI 技術的供給與需求之間存在落差。企業知道自己有需求，但不容易判斷哪一種模型、
          哪一套平台真的適合；技術供應者則不容易取得中立的效能驗證。
        </p>
        <p>
          聯盟以學術單位的身分介入這個落差。一方面舉辦教育課程、展會與技術交流，讓知識流動；
          一方面提供效能評估與基準測試，讓選擇有依據。
        </p>
        <p>
          在此之上，針對已經確定方向的企業，提供分析式與生成式 AI 平台的設計與落地服務。
        </p>
      </div>

      <dl class="space-y-6 border-t pt-7 text-sm lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8" style="border-color: var(--rule)">
        <div>
          <dt style="color: var(--ink-faint)">主辦單位</dt>
          <dd class="mt-1.5 leading-relaxed">{site.org}</dd>
        </div>
        <div>
          <dt style="color: var(--ink-faint)">成立時間</dt>
          <dd class="reading mt-1.5">2024 年 3 月</dd>
        </div>
        <div>
          <dt style="color: var(--ink-faint)">計畫類型</dt>
          <dd class="mt-1.5">{site.funding}</dd>
        </div>
        <div>
          <dt style="color: var(--ink-faint)">聯盟角色</dt>
          <dd class="mt-1.5 leading-relaxed">獨立第三方評測與技術服務</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="border-t" style="border-color: var(--rule); background: var(--panel)">
    <div class="mx-auto max-w-5xl px-5 py-20">
      <h2 class="text-2xl sm:text-3xl">聯盟至今累積</h2>
      <dl class="mt-12 flex flex-wrap gap-x-16 gap-y-10">
        <div>
          <dt class="text-sm" style="color: var(--ink-faint)">電子報發行</dt>
          <dd class="reading mt-2 text-4xl" style="font-family: var(--font-display)">
            {issues.length}<span class="ml-1.5 text-base" style="color: var(--ink-soft)">期</span>
          </dd>
          <dd class="mt-2 text-sm" style="color: var(--ink-soft)">自 2023 年 11 月起每月發行</dd>
        </div>
        <div>
          <dt class="text-sm" style="color: var(--ink-faint)">收錄文章</dt>
          <dd class="reading mt-2 text-4xl" style="font-family: var(--font-display)">
            {totalArticles}<span class="ml-1.5 text-base" style="color: var(--ink-soft)">篇</span>
          </dd>
          <dd class="mt-2 text-sm" style="color: var(--ink-soft)">AI 工具、模型與產業動態</dd>
        </div>
        <div>
          <dt class="text-sm" style="color: var(--ink-faint)">服務方向</dt>
          <dd class="reading mt-2 text-4xl" style="font-family: var(--font-display)">
            {services.length}<span class="ml-1.5 text-base" style="color: var(--ink-soft)">項</span>
          </dd>
          <dd class="mt-2 text-sm" style="color: var(--ink-soft)">從交流、評測到平台設計</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 py-20">
    <h2 class="text-2xl sm:text-3xl">三個服務方向</h2>
    <div class="axis mt-12 space-y-12">
      {
        services.map((s, i) => (
          <article class="tick" data-major>
            <div class="flex items-baseline gap-4">
              <span class="reading text-sm" style="color: var(--signal)">
                {i + 1}
              </span>
              <h3 class="text-xl">{s.title}</h3>
            </div>
            <p class="mt-4 max-w-2xl text-[15px] leading-loose" style="color: var(--ink-soft)">
              {s.summary}
            </p>
            <a
              href={`/services/#${s.id}`}
              class="mt-4 inline-block border-b pb-0.5 text-sm"
              style="color: var(--link); border-color: var(--rule-strong)"
            >
              服務細節
            </a>
          </article>
        ))
      }
    </div>
  </section>
</Base>
