---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site, contact, hasContactInfo, relatedLinks, membership } from '../config/site';

if (!hasContactInfo) {
  console.warn(
    '[contact] 尚未填寫聯絡窗口資料，/contact/ 只會顯示主辦單位與相關連結。請在 src/config/site.ts 的 contact 補上姓名、電話、信箱與地址。',
  );
}
---

<Base title="聯絡我們" description={`與 ${site.name} 聯絡，了解服務內容與入會方式。`}>
  <PageHeader title="聯絡聯盟" lead="想了解服務內容或入會方式，歡迎與聯盟聯絡。" />

  <section class="mx-auto max-w-5xl px-5 py-20">
    <div class="grid gap-14 lg:grid-cols-2 lg:gap-20">
      <div>
        <h2 class="text-xl">聯盟窗口</h2>
        {
          hasContactInfo ? (
            <dl class="mt-8">
              {contact.person && (
                <div class="border-t py-4" style="border-color: var(--rule)">
                  <dt class="text-sm" style="color: var(--ink-faint)">窗口</dt>
                  <dd class="mt-1.5">{contact.person}</dd>
                </div>
              )}
              {contact.phone && (
                <div class="border-t py-4" style="border-color: var(--rule)">
                  <dt class="text-sm" style="color: var(--ink-faint)">電話</dt>
                  <dd class="reading mt-1.5">
                    <a href={`tel:${contact.phone.replace(/[^\d+]/g, '')}`} style="color: var(--link)">
                      {contact.phone}
                    </a>
                  </dd>
                </div>
              )}
              {contact.email && (
                <div class="border-t py-4" style="border-color: var(--rule)">
                  <dt class="text-sm" style="color: var(--ink-faint)">信箱</dt>
                  <dd class="mt-1.5">
                    <a href={`mailto:${contact.email}`} style="color: var(--link)">
                      {contact.email}
                    </a>
                  </dd>
                </div>
              )}
              {contact.address && (
                <div class="border-t py-4" style="border-color: var(--rule)">
                  <dt class="text-sm" style="color: var(--ink-faint)">地址</dt>
                  <dd class="mt-1.5 leading-relaxed">{contact.address}</dd>
                </div>
              )}
            </dl>
          ) : (
            <p class="mt-8 max-w-md text-[15px] leading-loose" style="color: var(--ink-soft)">
              聯盟由{site.org}主辦。若要洽詢服務內容或入會方式，可先下載
              <a href={membership.applicationForm} style="color: var(--link)">會員申請表</a>
              ，或透過下方主辦單位的管道聯絡。
            </p>
          )
        }
      </div>

      <div>
        <h2 class="text-xl">主辦單位</h2>
        <p class="mt-8 text-lg leading-relaxed" style="font-family: var(--font-display)">{site.org}</p>
        <p class="mt-4 max-w-md text-[15px] leading-loose" style="color: var(--ink-soft)">
          於 2024 年 3 月成立 myLLM 產學聯盟，以獨立第三方角色提供大型語言模型的評測與技術服務。
        </p>
        <p class="mt-6 text-sm" style="color: var(--ink-faint)">{site.funding}</p>
      </div>
    </div>

    {
      contact.mapEmbed && (
        <iframe
          src={contact.mapEmbed}
          title="聯盟位置地圖"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="mt-16 block h-80 w-full border"
          style="border-color: var(--rule)"
        />
      )
    }
  </section>

  <section class="border-t" style="border-color: var(--rule); background: var(--panel)">
    <div class="mx-auto max-w-5xl px-5 py-20">
      <h2 class="text-2xl">相關連結</h2>
      <dl class="mt-10 grid gap-x-12 sm:grid-cols-2">
        {
          relatedLinks.map((link) => (
            <div class="border-t py-5" style="border-color: var(--rule)">
              <dt>
                <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-base" style="color: var(--link)">
                  {link.label}
                </a>
              </dt>
              <dd class="mt-1.5 text-sm" style="color: var(--ink-soft)">
                {link.note}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</Base>
