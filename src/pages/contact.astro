---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { Icon } from 'astro-icon/components';
import { site, contact, hasContactInfo, relatedLinks, membership } from '../config/site';

if (!hasContactInfo) {
  console.warn(
    '[contact] 尚未填寫聯絡窗口資料，/contact/ 只會顯示主辦單位與相關連結。請在 src/config/site.ts 的 contact 補上姓名、電話、信箱與地址。',
  );
}

const channels = [
  contact.person && { icon: 'lucide:user-round', label: '窗口', value: contact.person },
  contact.phone && { icon: 'lucide:phone', label: '電話', value: contact.phone, href: `tel:${contact.phone.replace(/[^\d+]/g, '')}` },
  contact.email && { icon: 'lucide:mail', label: '信箱', value: contact.email, href: `mailto:${contact.email}` },
  contact.address && { icon: 'lucide:map-pin', label: '地址', value: contact.address },
].filter(Boolean) as { icon: string; label: string; value: string; href?: string }[];
---

<Base title="聯絡我們" description={`與 ${site.name} 聯絡，了解服務內容與入會方式。`}>
  <PageHeader title="聯絡聯盟" lead="想了解服務內容或入會方式，歡迎與聯盟聯絡。" />

  <section class="mx-auto max-w-6xl px-5 py-24">
    <div class="grid-rules lg:grid-cols-2">
      <div class="px-1 py-10 lg:pr-12 lg:pl-0">
        <h2 class="text-2xl sm:text-3xl">聯盟窗口</h2>
        {
          hasContactInfo ? (
            <dl class="mt-8">
              {channels.map((c) => (
                <div class="flex items-center gap-4 border-t py-4" style="border-color: var(--hairline)">
                  <Icon name={c.icon} class="size-5 shrink-0" style="color: var(--signal)" />
                  <div class="min-w-0">
                    <dt class="text-xs" style="color: var(--ink-faint)">{c.label}</dt>
                    <dd class="mt-0.5 break-words">{c.href ? <a href={c.href} class="link-line">{c.value}</a> : c.value}</dd>
                  </div>
                </div>
              ))}
            </dl>
          ) : (
            <p class="mt-6 max-w-md text-[15px] leading-loose" style="color: var(--ink-soft)">
              聯盟由{site.org}主辦。洽詢服務內容或入會方式，可以先下載會員申請表，或透過下方主辦單位的管道聯絡。
            </p>
          )
        }
        <a href={membership.applicationForm} class="btn-primary mt-8">
          <Icon name="lucide:file-down" class="size-4" />
          下載會員申請表
        </a>
      </div>

      <div class="px-1 py-10 lg:pl-12">
        <h2 class="text-2xl sm:text-3xl">主辦單位</h2>
        <p class="mt-6 text-lg leading-relaxed" style="font-family: var(--font-display)">{site.org}</p>
        <p class="mt-4 max-w-md text-[15px] leading-loose" style="color: var(--ink-soft)">
          於 2024 年 3 月成立 myLLM 產學聯盟，以獨立第三方角色提供大型語言模型的評測與技術服務。
        </p>
        <p class="mt-6 inline-flex items-center gap-2 text-sm" style="color: var(--ink-faint)">
          <span class="led"></span>{site.funding}
        </p>
      </div>
    </div>

    {
      contact.mapEmbed && (
        <iframe
          src={contact.mapEmbed}
          title="聯盟位置地圖"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="frame mt-12 block h-80 w-full border-0"
        />
      )
    }
  </section>

  <section style="background: var(--surface-2)">
    <div class="mx-auto max-w-6xl px-5 py-24">
      <h2 class="text-3xl sm:text-4xl">相關連結</h2>
      <ul class="hairline-list mt-12">
        {
          relatedLinks.map((link) => (
            <li class="hairline-row">
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="grid items-baseline gap-x-6 gap-y-1 py-6 sm:grid-cols-[1.3fr_1fr_1.5rem]"
              >
                <span class="text-lg" style="font-family: var(--font-display)">{link.label}</span>
                <span class="text-sm" style="color: var(--ink-soft)">
                  {link.note}
                </span>
                <Icon name="lucide:arrow-up-right" class="row-arrow hidden size-5 sm:block" style="color: var(--ink-faint)" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
