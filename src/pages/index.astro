---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { services, edgeLanding } from '../data/services';
import issues from '../data/newsletter.json';

const totalArticles = issues.reduce((n, i) => n + i.articles.length, 0);
const latest = issues.slice(0, 4);
---

<Base path="/">
  {/* 開場：聯盟的身份與它量測的對象 */}
  <section class="mx-auto max-w-5xl px-5 pt-20 pb-24 sm:pt-28">
    <p class="text-sm" style="color: var(--ink-soft)">{site.org}</p>
    <h1 class="mt-5 max-w-3xl text-4xl leading-[1.25] sm:text-5xl md:text-[3.5rem]">
      替台灣產業量測<br />大型語言模型的真實能力
    </h1>
    <p class="mt-8 max-w-xl text-[15px] leading-loose" style="color: var(--ink-soft)">
      myLLM 產學聯盟成立於 2024 年 3 月，以獨立第三方角色執行 AI 系統的效能評估與基準測試，
      並把驗證過的模型帶進企業自己的環境落地。
    </p>

    <dl class="mt-14 flex flex-wrap gap-x-14 gap-y-8 border-t pt-8" style="border-color: var(--rule)">
      <div>
        <dt class="text-sm" style="color: var(--ink-faint)">電子報</dt>
        <dd class="reading mt-1.5 text-3xl" style="font-family: var(--font-display)">
          {issues.length}<span class="ml-1 text-base" style="color: var(--ink-soft)">期</span>
        </dd>
      </div>
      <div>
        <dt class="text-sm" style="color: var(--ink-faint)">收錄文章</dt>
        <dd class="reading mt-1.5 text-3xl" style="font-family: var(--font-display)">
          {totalArticles}<span class="ml-1 text-base" style="color: var(--ink-soft)">篇</span>
        </dd>
      </div>
      <div>
        <dt class="text-sm" style="color: var(--ink-faint)">開始發行</dt>
        <dd class="reading mt-1.5 text-3xl" style="font-family: var(--font-display)">2023.11</dd>
      </div>
    </dl>
  </section>

  {/* 三項服務對應企業導入 LLM 的先後階段，因此掛在同一條軸上依序展開 */}
  <section class="border-t" style="border-color: var(--rule); background: var(--panel)">
    <div class="mx-auto max-w-5xl px-5 py-20">
      <h2 class="text-2xl sm:text-3xl">企業導入 LLM 的三個階段</h2>
      <div class="axis mt-12 space-y-14">
        {
          services.map((s, i) => (
            <article class="tick" data-major>
              <div class="flex items-baseline gap-4">
                <span class="reading text-sm" style="color: var(--signal)">
                  {i + 1}
                </span>
                <h3 class="text-xl">{s.title}</h3>
              </div>
              <p class="mt-4 max-w-2xl text-[15px] leading-loose" style="color: var(--ink-soft)">
                {s.detail[0]}
              </p>
              <a
                href={`/services/#${s.id}`}
                class="mt-4 inline-block border-b pb-0.5 text-sm"
                style="color: var(--link); border-color: var(--rule-strong)"
              >
                {s.title}的服務內容
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* Edge Landing：並列的六個項目，沒有先後，用清單而非軸 */}
  <section class="mx-auto max-w-5xl px-5 py-20">
    <h2 class="text-2xl sm:text-3xl">在企業自己的環境裡落地</h2>
    <p class="mt-5 max-w-xl text-[15px] leading-loose" style="color: var(--ink-soft)">
      Edge Landing 讓模型在現場執行，資料不必離開企業。目前提供六項服務。
    </p>
    <dl class="mt-12 grid gap-x-12 sm:grid-cols-2">
      {
        edgeLanding.map((item) => (
          <div class="border-t py-6" style="border-color: var(--rule)">
            <dt class="text-base font-medium">{item.title}</dt>
            <dd class="mt-2 text-sm leading-loose" style="color: var(--ink-soft)">
              {item.description}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  {/* 電子報：最新幾期以讀數排列，期號對齊便於比對 */}
  <section class="border-t" style="border-color: var(--rule); background: var(--panel)">
    <div class="mx-auto max-w-5xl px-5 py-20">
      <h2 class="text-2xl sm:text-3xl">AI 電子報</h2>
      <p class="mt-5 max-w-xl text-[15px] leading-loose" style="color: var(--ink-soft)">
        每月整理值得一看的 AI 工具、模型與產業動態，自 2023 年 11 月起累積 {issues.length} 期。
      </p>
      <ul class="mt-12">
        {
          latest.map((issue) => (
            <li class="border-t" style="border-color: var(--rule)">
              <a href={`/newsletter/${issue.no}/`} class="flex flex-wrap items-baseline gap-x-6 gap-y-1 py-5">
                <span class="reading w-12 text-lg" style="font-family: var(--font-display); color: var(--signal)">
                  {issue.no}
                </span>
                <span class="reading text-sm" style="color: var(--ink-faint)">
                  {issue.date}
                </span>
                <span class="min-w-0 flex-1 text-[15px]">{issue.articles[0]?.title}</span>
                <span class="reading text-sm" style="color: var(--ink-faint)">
                  {issue.articles.length} 篇
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href="/newsletter/"
        class="mt-8 inline-block border-b pb-0.5 text-sm"
        style="color: var(--link); border-color: var(--rule-strong)"
      >
        瀏覽全部 {issues.length} 期
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 py-24">
    <h2 class="max-w-xl text-2xl leading-snug sm:text-3xl">
      想知道貴公司的 AI 系統表現如何？
    </h2>
    <p class="mt-6 max-w-xl text-[15px] leading-loose" style="color: var(--ink-soft)">
      聯盟會員可取得專業諮詢與平台評測資源。歡迎先了解入會方式，或直接與我們聯絡。
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-8">
      <a
        href="/membership/"
        class="px-6 py-3 text-sm font-medium"
        style="background: var(--signal); color: var(--signal-face)"
      >
        成為聯盟會員
      </a>
      <a href="/contact/" class="border-b pb-0.5 text-sm" style="color: var(--link); border-color: var(--rule-strong)">
        聯絡聯盟窗口
      </a>
    </div>
  </section>
</Base>
