---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { services, edgeLanding, devices } from '../data/services';
import { empowerment } from '../data/empowerment';
import issues from '../data/newsletter.json';

const totalArticles = issues.reduce((n, i) => n + i.articles.length, 0);
const latest = issues.slice(0, 4);
---

<Base path="/">
  {/* 開場：聯盟自己的主張，配上漫畫視覺 */}
  <section class="inverse relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 halftone-dense opacity-[0.07]"
      style="color: var(--void)"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 md:grid-cols-[1.1fr_1fr] md:gap-14 md:py-24">
      <div>
        <p class="text-sm" style="color: color-mix(in srgb, var(--void) 62%, transparent)">
          {site.org}
        </p>
        <h1 class="mt-6 text-[2.75rem] leading-[1.15] sm:text-6xl md:text-[4.25rem]">
          資料不落雲<br />
          <span style="color: var(--signal)">AI 要落地</span>
        </h1>
        <p
          class="mt-8 max-w-md text-[15px] leading-loose"
          style="color: color-mix(in srgb, var(--void) 78%, transparent)"
        >
          生成式 AI 的軟硬體整合，做在企業自己的機器上。myLLM 產學聯盟以獨立第三方角色
          評測模型效能，並把驗證過的模型帶進現場。
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-6">
          <a
            href="/services/"
            class="px-7 py-3.5 text-sm font-medium"
            style="background: var(--signal); color: #fff"
          >
            我們做什麼
          </a>
          <a
            href="/membership/"
            class="border-b pb-1 text-sm"
            style="color: var(--void); border-color: color-mix(in srgb, var(--void) 45%, transparent)"
          >
            成為聯盟會員
          </a>
        </div>
      </div>

      <div class="cut-br relative">
        <img
          src="/images/robot-comic.webp"
          alt="漫畫風格的機器人衝出畫面，象徵 AI 落地到實際場景"
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
          class="block w-full"
        />
      </div>
    </div>
  </section>

  {/* 企業賦能：聯盟自己的比喻 */}
  <section class="mx-auto max-w-6xl px-5 py-20">
    <h2 class="max-w-2xl text-3xl leading-snug sm:text-4xl">{empowerment.headline}</h2>
    <div class="mt-12 grid gap-10 md:grid-cols-[1fr_1fr] md:gap-16">
      <dl class="space-y-8">
        {
          empowerment.contrast.map((c) => (
            <div class="border-t-2 pt-5" style="border-color: var(--rule-strong)">
              <dt class="text-2xl" style="font-family: var(--font-display)">
                {c.subject}
              </dt>
              <dd class="mt-3 text-[15px] leading-loose" style="color: var(--ink-soft)">
                {c.body}
              </dd>
            </div>
          ))
        }
        <p class="text-lg" style="color: var(--signal); font-family: var(--font-display)">
          {empowerment.note}
        </p>
      </dl>

      <div class="cut-tl p-7 md:p-9" style="background: var(--panel)">
        <p class="text-sm" style="color: var(--ink-faint)">企業賦能員工要具備的能力</p>
        <ol class="mt-6 space-y-4">
          {
            empowerment.abilities.map((a, i) => (
              <li class="flex gap-4 border-b pb-4 text-[15px]" style="border-color: var(--rule)">
                <span class="reading shrink-0 text-sm" style="color: var(--signal)">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span>{a}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  {/* 評測平台：實機照片是第三方評比的實體依據 */}
  <section class="border-y" style="border-color: var(--rule-strong); background: var(--panel)">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="max-w-xl text-3xl leading-snug sm:text-4xl">在六種嵌入式裝置上跑過同一組測試</h2>
        <p class="reading text-sm" style="color: var(--ink-faint)">低配 · 中配 · 高配</p>
      </div>

      <figure class="mt-10">
        <img
          src="/images/edge-devices.jpg"
          alt="桌面上並排陳列六種嵌入式裝置，依序為 Raspberry Pi 4、Raspberry Pi 5、Jetson Xavier、N3000、Jetson Orin 與 Mac Studio，各自標示配置等級"
          width="2876"
          height="832"
          loading="lazy"
          class="block w-full border"
          style="border-color: var(--rule)"
        />
        <figcaption class="mt-4 text-sm" style="color: var(--ink-faint)">
          聯盟的評測平台。同一組模型在不同等級的裝置上實測，效能比較才有基準。
        </figcaption>
      </figure>

      <ul class="mt-10 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          devices.map((d) => (
            <li class="flex items-baseline justify-between gap-4 border-t py-4" style="border-color: var(--rule)">
              <span class="text-[15px] font-medium">{d.name}</span>
              <span class="text-sm" style="color: var(--ink-faint)">
                {d.vendor}
              </span>
              <span class="text-xs" style="color: var(--signal)">
                {d.tier}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* 三項服務對應導入的先後階段 */}
  <section class="mx-auto max-w-6xl px-5 py-20">
    <h2 class="text-3xl sm:text-4xl">企業導入 LLM 的三個階段</h2>
    <div class="axis mt-14 space-y-14">
      {
        services.map((s, i) => (
          <article class="tick" data-major>
            <div class="flex items-baseline gap-4">
              <span class="reading text-sm" style="color: var(--signal)">
                {i + 1}
              </span>
              <h3 class="text-xl sm:text-2xl">{s.title}</h3>
            </div>
            <p class="mt-4 max-w-2xl text-[15px] leading-loose" style="color: var(--ink-soft)">
              {s.detail[0]}
            </p>
            <a
              href={`/services/#${s.id}`}
              class="mt-4 inline-block border-b pb-0.5 text-sm"
              style="border-color: var(--rule-strong)"
            >
              {s.title}的服務內容
            </a>
          </article>
        ))
      }
    </div>
  </section>

  {/* Edge Landing 七項並列服務 */}
  <section class="border-t" style="border-color: var(--rule)">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <h2 class="text-3xl sm:text-4xl">Edge Landing 服務</h2>
      <p class="mt-6 max-w-xl text-[15px] leading-loose" style="color: var(--ink-soft)">
        讓模型在企業自己的環境裡執行，資料不必離開現場。
      </p>
      <dl class="mt-12 grid gap-x-10 md:grid-cols-2">
        {
          edgeLanding.map((item) => (
            <div class="border-t py-6" style="border-color: var(--rule)">
              <dt class="text-base font-medium">{item.title}</dt>
              <dd class="mt-2 text-sm leading-loose" style="color: var(--ink-soft)">
                {item.description}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* 電子報 */}
  <section style="background: var(--panel)">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="text-3xl sm:text-4xl">AI 電子報</h2>
        <p class="reading text-sm" style="color: var(--ink-faint)">
          {issues.length} 期 · {totalArticles} 篇 · 自 2023.11
        </p>
      </div>
      <ul class="mt-12">
        {
          latest.map((issue) => (
            <li class="border-t" style="border-color: var(--rule)">
              <a href={`/newsletter/${issue.no}/`} class="flex flex-wrap items-baseline gap-x-6 gap-y-1 py-5">
                <span class="reading w-10 text-xl" style="font-family: var(--font-display); color: var(--signal)">
                  {issue.no}
                </span>
                <span class="reading text-sm" style="color: var(--ink-faint)">
                  {issue.date}
                </span>
                <span class="min-w-0 flex-1 text-[15px]">{issue.articles[0]?.title}</span>
                <span class="reading text-sm" style="color: var(--ink-faint)">
                  {issue.articles.length} 篇
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/newsletter/" class="mt-8 inline-block border-b pb-0.5 text-sm" style="border-color: var(--rule-strong)">
        瀏覽全部 {issues.length} 期
      </a>
    </div>
  </section>

  {/* 結尾 */}
  <section class="inverse relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 halftone opacity-[0.06]" style="color: var(--void)" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-5 py-20">
      <h2 class="max-w-xl text-3xl leading-snug sm:text-4xl">想知道貴公司的 AI 系統表現如何？</h2>
      <p
        class="mt-6 max-w-xl text-[15px] leading-loose"
        style="color: color-mix(in srgb, var(--void) 78%, transparent)"
      >
        會員可取得專業諮詢與平台評測資源。
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-6">
        <a href="/membership/" class="px-7 py-3.5 text-sm font-medium" style="background: var(--signal); color: #fff">
          成為聯盟會員
        </a>
        <a
          href="/contact/"
          class="border-b pb-1 text-sm"
          style="color: var(--void); border-color: color-mix(in srgb, var(--void) 45%, transparent)"
        >
          聯絡聯盟窗口
        </a>
      </div>
    </div>
  </section>
</Base>
