---
/**
 * 首頁。每個區塊選用的呈現手法與理由記錄在 docs/design-research.md 的對照表。
 * 原則：卡片只在需要並列比較時使用，全頁只有結尾一個面板。
 */
import Base from '../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import FundingBadge from '../components/FundingBadge.astro';
import { site } from '../config/site';
import { services, edgeLanding, devices } from '../data/services';
import { empowerment } from '../data/empowerment';
import { benchmark } from '../data/benchmark';
import issues from '../data/newsletter.json';

const totalArticles = issues.reduce((n, i) => n + i.articles.length, 0);
const latest = issues.slice(0, 5);
const seven = benchmark.find((b) => b.model === '7B')!;
const speedup = (seven.tokPerSec[0]! / seven.tokPerSec[2]!).toFixed(1);

// 懸停顯圖清單：每一項取示範機型照，沒有的話取第一張截圖
const revealRows = edgeLanding.map((item) => ({
  ...item,
  img: item.device?.image ?? item.visuals[0]?.src ?? '',
}));

const stats = [
  { value: String(seven.tokPerSec[0]), unit: 'tok/s', label: '7B 模型量化到 4 bits 的生成速度' },
  { value: speedup, unit: '×', label: '比 16 bits 快的倍數' },
  { value: String(seven.mmlu[0]), unit: '%', label: '量化後的 MMLU 準確率，只降 0.2 個百分點' },
  { value: String(devices.length), unit: '種', label: '從樹莓派到 Mac Studio 的評測裝置' },
];
---

<Base path="/">
  {/* Split Hero：主張、說明與規模在首屏同時交代 */}
  <section class="inverse relative overflow-hidden">
    <div class="aurora" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-5 pt-14 pb-20 md:grid-cols-[1.15fr_1fr] md:gap-16 md:pt-20 md:pb-24">
      <div class="stage-in">
        <FundingBadge variant="dark" withOrg size="lg" />
        <h1 class="mt-7 text-[2.6rem] leading-[1.14] sm:text-[3.4rem] md:text-[3.9rem]">
          <span class="whitespace-nowrap">資料不落雲，</span><span class="whitespace-nowrap" style="color: #d9a441">AI 要落地。</span>
          <span class="tonal-dim block text-[0.62em] leading-[1.35] mt-3">
            在企業自己的機器上，用上驗證過的大型語言模型。
          </span>
        </h1>
        <p class="muted mt-8 max-w-md text-[15px] leading-loose">
          我們以獨立第三方角色
          <a href="/services/#benchmark" class="link-line text-white">評測模型效能</a>，並把
          <a href="/services/#edge-landing" class="link-line text-white">驗證過的模型帶進現場</a>。
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a href="/services/" class="btn-primary">
            我們做什麼
            <Icon name="lucide:arrow-right" class="btn-arrow size-4" />
          </a>
          <a href="/membership/" class="btn-ghost">成為聯盟會員</a>
        </div>
        <p class="muted mt-8 flex flex-wrap items-baseline gap-x-2 text-sm">
          <span class="led self-center"></span>
          已發行
          <span class="reading text-base text-white" data-ticker data-to={totalArticles}>{totalArticles}</span>
          篇 AI 電子報，共
          <span class="reading text-base text-white" data-ticker data-to={issues.length}>{issues.length}</span>
          期
        </p>
      </div>

      <div class="float relative">
        <div class="absolute -inset-5 rounded-[2rem] opacity-60 blur-2xl" style="background: radial-gradient(60% 60% at 50% 50%, rgb(217 164 65 / 0.3), transparent)" aria-hidden="true"></div>
        <img
          src="/images/robot-comic.webp"
          alt="漫畫風格的機器人衝出畫面，象徵 AI 落地到實際場景"
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
          class="frame relative block w-full"
          style="border-color: rgb(255 255 255 / 0.12)"
        />
      </div>
    </div>

    {/* Proof Strip：評測平台的裝置就是信任來源 */}
    <div class="relative border-t" style="border-color: rgb(255 255 255 / 0.1)">
      <div class="mx-auto max-w-6xl px-5">
        <p class="muted pt-6 text-xs">在這六種嵌入式裝置上跑過同一組測試</p>
        <ul class="grid-rules mt-4 grid-cols-2 sm:grid-cols-3 lg:grid-cols-6" style="border-bottom: 0">
          {
            devices.map((d) => (
              <li class="flex flex-col gap-1 px-4 py-5">
                <span class="text-sm font-medium text-white">{d.name}</span>
                <span class="muted flex items-center gap-1.5 text-xs">
                  {d.vendor}
                  <span style="color: #d9a441">{d.tier}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* Statement：聯盟的核心論點，一整個區塊只放這一句 */}
  <section class="top-glow mx-auto max-w-6xl px-5 pt-28 pb-24">
    <p class="relative statement max-w-4xl">
      超人難尋，<br class="sm:hidden" />
      <span style="color: var(--signal)">鋼鐵人可以量產。</span>
    </p>
    <div class="relative mt-16 grid gap-px md:grid-cols-2" style="background: var(--hairline)">
      {
        empowerment.contrast.map((c, i) => (
          <div class="flex gap-5 py-8 md:px-8 md:first:pl-0" style="background: var(--void)">
            <Icon
              name={i === 0 ? 'lucide:user-round' : 'lucide:bot'}
              class="mt-1 size-7 shrink-0"
              style={i === 0 ? 'color: var(--ink-faint)' : 'color: var(--signal)'}
            />
            <div>
              <h3 class="text-2xl">{c.subject}</h3>
              <p class="mt-3 text-[15px] leading-loose" style="color: var(--ink-soft)">
                {c.body}
              </p>
            </div>
          </div>
        ))
      }
    </div>
    <p class="relative mt-10 text-[15px] leading-loose" style="color: var(--ink-soft)">
      {empowerment.note}企業賦能員工要具備的能力：
      {
        empowerment.abilities.map((a, i) => (
          <>
            <span style="color: var(--ink)">{a}</span>
            {i < empowerment.abilities.length - 1 && <span class="mx-2" style="color: var(--ink-faint)">／</span>}
          </>
        ))
      }
    </p>
  </section>

  {/* Visible Grid 數字帶：實測結果要能一眼橫向比較 */}
  <section style="background: var(--surface-2)">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="max-w-xl text-3xl leading-snug sm:text-4xl">量化到 4 bits，速度快三倍，準確率幾乎不掉</h2>
        <a href="/services/#benchmark" class="link-line text-sm">
          完整測試數據
          <Icon name="lucide:arrow-up-right" class="size-3.5" />
        </a>
      </div>
      <dl class="grid-rules on-panel mt-12 grid-cols-2 lg:grid-cols-4">
        {
          stats.map((st) => (
            <div class="flex flex-col justify-between gap-6 px-5 py-8 sm:px-7">
              <dd class="flex items-baseline gap-1.5">
                <span class="reading text-5xl sm:text-6xl" style="font-family: var(--font-display)" data-ticker data-to={st.value}>
                  {st.value}
                </span>
                <span class="text-lg" style="color: var(--signal)">{st.unit}</span>
              </dd>
              <dt class="text-sm leading-relaxed" style="color: var(--ink-soft)">
                {st.label}
              </dt>
            </div>
          ))
        }
      </dl>
      <p class="mt-5 text-xs" style="color: var(--ink-faint)">實測於 Jetson Orin</p>
    </div>
  </section>

  {/* Sticky Storytelling：階段有先後，捲動才看得出順序 */}
  <section class="story mx-auto max-w-6xl px-5 py-28" data-story>
    <div class="grid gap-12 md:grid-cols-[1fr_1.1fr] md:gap-20">
      <div class="md:sticky md:top-28 md:self-start">
        <h2 class="text-3xl sm:text-4xl">企業導入 LLM 的三個階段</h2>
        <div class="story-progress mt-8 grid grid-cols-3 gap-2" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <div class="story-panel mt-10 hidden h-56 md:block" aria-hidden="true">
          {
            services.map((s, i) => (
              <div data-panel={i + 1} class="flex flex-col justify-end">
                <Icon name={s.icon} class="size-10" style="color: var(--signal)" />
                <p class="reading mt-6 text-[7rem] leading-none" style="font-family: var(--font-display); color: transparent; -webkit-text-stroke: 1.5px color-mix(in srgb, var(--signal) 70%, transparent)">
                  0{i + 1}
                </p>
              </div>
            ))
          }
        </div>
      </div>

      <ol class="space-y-24 md:space-y-40 md:py-10">
        {
          services.map((s, i) => (
            <li data-step={i + 1}>
              <p class="reading text-sm" style="color: var(--signal)">
                階段 {i + 1}
              </p>
              <h3 class="mt-3 text-2xl sm:text-3xl">{s.title}</h3>
              <p class="mt-5 text-lg leading-relaxed">{s.summary}</p>
              <p class="mt-4 text-[15px] leading-loose" style="color: var(--ink-soft)">
                {s.detail[0]}
              </p>
              <a href={`/services/#${s.id}`} class="link-line mt-6 text-sm" style="color: var(--signal)">
                這個階段的服務
                <Icon name="lucide:arrow-right" class="size-4" />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* Hover Reveal List：七項都有實機照，攤開會變成圖片牆，改成滑到才浮出 */}
  <section class="border-t" style="border-color: var(--hairline)" data-reveal-list>
    <div class="mx-auto max-w-6xl px-5 py-24">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <h2 class="text-3xl sm:text-4xl">Edge Landing 七項落地服務</h2>
          <p class="mt-4 text-[15px]" style="color: var(--ink-soft)">模型在企業自己的環境裡執行，資料不必離開現場。</p>
        </div>
        <p class="hidden text-xs md:block" style="color: var(--ink-faint)">滑過每一項，看示範現場</p>
      </div>

      <ul class="hairline-list mt-12">
        {
          revealRows.map((item) => (
            <li class="hairline-row" data-reveal-row data-img={item.img} data-alt={`${item.title}的示範現場`}>
              <a href={`/services/#${item.id}`} class="grid items-center gap-x-6 gap-y-2 py-6 md:grid-cols-[2.5rem_1.3fr_1.7fr_9rem_1.5rem]">
                <Icon name={item.icon} class="size-6" style="color: var(--signal)" />
                <span class="text-lg" style="font-family: var(--font-display)">{item.title}</span>
                <span class="text-sm leading-relaxed" style="color: var(--ink-soft)">
                  {item.summary}
                </span>
                <span class="text-xs" style="color: var(--ink-faint)">
                  {item.device?.name ?? ''}
                </span>
                <Icon name="lucide:arrow-right" class="row-arrow hidden size-5 md:block" style="color: var(--ink-faint)" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <img data-reveal-img class="reveal-float" alt="" src="data:image/gif;base64,R0lGODlhAQABAAAAACw=" />
  </section>

  {/* Hairline Index：清單型內容，要能掃讀日期與標題 */}
  <section style="background: var(--surface-2)">
    <div class="mx-auto max-w-6xl px-5 py-24">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="text-3xl sm:text-4xl">最新的 AI 電子報</h2>
        <a href="/newsletter/" class="link-line text-sm">
          瀏覽全部 {issues.length} 期
          <Icon name="lucide:arrow-up-right" class="size-3.5" />
        </a>
      </div>
      <ul class="hairline-list mt-12">
        {
          latest.map((issue) => (
            <li class="hairline-row">
              <a href={`/newsletter/${issue.no}/`} class="grid items-baseline gap-x-6 gap-y-1 py-5 sm:grid-cols-[3.5rem_5.5rem_1fr_4rem_1.5rem]">
                <span class="reading text-2xl" style="font-family: var(--font-display); color: var(--signal)">
                  {issue.no}
                </span>
                <span class="reading text-sm" style="color: var(--ink-faint)">
                  {issue.date}
                </span>
                <span class="text-[15px] leading-relaxed">{issue.articles[0]?.title}</span>
                <span class="reading text-sm" style="color: var(--ink-faint)">
                  {issue.articles.length} 篇
                </span>
                <Icon name="lucide:arrow-right" class="row-arrow hidden size-5 sm:block" style="color: var(--ink-faint)" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Media Panel：全頁唯一的面板，留給行動呼籲 */}
  <section class="mx-auto max-w-6xl px-5 py-24">
    <div class="inverse relative overflow-hidden rounded-[2rem] px-8 py-16 sm:px-14">
      <div class="aurora" aria-hidden="true"></div>
      <div class="relative max-w-xl">
        <h2 class="text-3xl leading-snug sm:text-4xl">想知道貴公司的 AI 系統表現如何？</h2>
        <p class="muted mt-6 text-[15px] leading-loose">會員可取得專業諮詢與平台評測資源。</p>
        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a href="/membership/" class="btn-primary">
            成為聯盟會員
            <Icon name="lucide:arrow-right" class="btn-arrow size-4" />
          </a>
          <a href="/contact/" class="btn-ghost">聯絡聯盟窗口</a>
        </div>
      </div>
    </div>
  </section>
</Base>
