---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { services, edgeLanding } from '../data/services';

// 最新三期電子報，連到既有的存檔頁（舊網址保持可用）
const latestIssues = [
  { no: 19, date: '2024.09' },
  { no: 18, date: '2024.08' },
  { no: 17, date: '2024.08' },
];
---

<Base path="/">
  {/* Hero */}
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10 opacity-60"
      style="background: radial-gradient(60rem 30rem at 50% -10%, var(--accent-soft), transparent 70%)"
      aria-hidden="true"
    >
    </div>
    <div class="mx-auto max-w-6xl px-4 py-20 text-center sm:py-28">
      <p
        class="inline-block rounded-full border px-3 py-1 text-xs font-medium"
        style="border-color: var(--border-strong); color: var(--ink-muted)"
      >
        {site.funding}
      </p>
      <h1 class="mx-auto mt-6 max-w-3xl text-4xl font-bold tracking-tight text-balance sm:text-5xl md:text-6xl">
        {site.tagline}
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-pretty sm:text-lg" style="color: var(--ink-muted)">
        {site.org}於 2024 年 3 月成立 myLLM 產學聯盟，以獨立第三方角色協助產業導入大型語言模型，
        涵蓋生態圈交流、平台落地評測與 AI 平台設計。
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a
          href="/membership/"
          class="rounded-xl px-6 py-3 text-sm font-bold transition-opacity hover:opacity-90"
          style="background: var(--accent); color: var(--accent-ink)"
        >
          成為聯盟會員
        </a>
        <a
          href="/services/"
          class="rounded-xl border px-6 py-3 text-sm font-bold transition-colors"
          style="border-color: var(--border-strong); color: var(--ink)"
        >
          了解核心服務
        </a>
      </div>
    </div>
  </section>

  {/* 三大核心服務 */}
  <section class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">核心服務</h2>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed" style="color: var(--ink-muted)">
      從交流、評測到平台設計，涵蓋企業導入 LLM 的三個階段。
    </p>
    <ul class="mt-10 grid gap-5 md:grid-cols-3">
      {
        services.map((s, i) => (
          <li
            class="flex flex-col rounded-2xl border p-6"
            style="border-color: var(--border); background: var(--surface); box-shadow: var(--shadow-card)"
          >
            <span class="text-xs font-bold tracking-widest" style="color: var(--accent)">
              {String(i + 1).padStart(2, '0')} · {s.titleEn}
            </span>
            <h3 class="mt-3 text-lg font-bold">{s.title}</h3>
            <p class="mt-3 text-sm leading-relaxed" style="color: var(--ink-muted)">
              {s.summary}
            </p>
            <a
              href={`/services/#${s.id}`}
              class="mt-auto pt-5 text-sm font-medium hover:underline"
              style="color: var(--accent)"
            >
              看服務內容 →
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/* Edge Landing */}
  <section style="background: var(--bg-subtle)">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Edge Landing 服務</h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed" style="color: var(--ink-muted)">
        讓模型在企業自己的環境裡落地，資料不必離開現場。
      </p>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          edgeLanding.map((item) => (
            <li class="rounded-xl border p-5" style="border-color: var(--border); background: var(--surface)">
              <h3 class="text-base font-bold">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed" style="color: var(--ink-muted)">
                {item.description}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* 電子報 */}
  <section class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">AI 電子報</h2>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed" style="color: var(--ink-muted)">
          每月整理值得一看的 AI 工具、模型與產業動態，累積 19 期。
        </p>
      </div>
      <a href="/newsletter/" class="text-sm font-medium hover:underline" style="color: var(--accent)">
        看全部 19 期 →
      </a>
    </div>
    <ul class="mt-10 grid gap-5 md:grid-cols-3">
      {
        latestIssues.map((issue) => (
          <li
            class="rounded-2xl border p-6"
            style="border-color: var(--border); background: var(--surface); box-shadow: var(--shadow-card)"
          >
            <p class="text-xs font-bold tracking-widest" style="color: var(--accent)">
              {issue.date}
            </p>
            <h3 class="mt-2 text-lg font-bold">第 {issue.no} 期</h3>
            <a
              href={`/news/newsletter/newsletter-${issue.no}.html`}
              class="mt-5 inline-block text-sm font-medium hover:underline"
              style="color: var(--accent)"
            >
              閱讀這一期 →
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/* 加入聯盟 */}
  <section class="mx-auto max-w-6xl px-4 pb-20">
    <div
      class="rounded-3xl border px-6 py-14 text-center"
      style="border-color: var(--border); background: var(--surface-raised)"
    >
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">加入 myLLM 產學聯盟</h2>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed" style="color: var(--ink-muted)">
        會員可取得專業諮詢、平台評測與技術交流資源。歡迎與我們聯絡了解入會方式。
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href="/membership/"
          class="rounded-xl px-6 py-3 text-sm font-bold transition-opacity hover:opacity-90"
          style="background: var(--accent); color: var(--accent-ink)"
        >
          會員資訊
        </a>
        <a
          href="/contact/"
          class="rounded-xl border px-6 py-3 text-sm font-bold"
          style="border-color: var(--border-strong); color: var(--ink)"
        >
          聯絡我們
        </a>
      </div>
    </div>
  </section>
</Base>
