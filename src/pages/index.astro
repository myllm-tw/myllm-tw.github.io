---
import Base from '../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../config/site';
import { services, edgeLanding, devices } from '../data/services';
import { empowerment } from '../data/empowerment';
import { benchmark } from '../data/benchmark';
import issues from '../data/newsletter.json';

const totalArticles = issues.reduce((n, i) => n + i.articles.length, 0);
const latest = issues.slice(0, 3);
const seven = benchmark.find((b) => b.model === '7B')!;
const speedup = (seven.tokPerSec[0]! / seven.tokPerSec[2]!).toFixed(1);
const deviceTicker = [...devices, ...devices];
---

<Base path="/">
  {/* 開場：極光背景 + 聯盟主張 + 漫畫插圖 */}
  <section class="inverse relative overflow-hidden">
    <div class="aurora" aria-hidden="true"></div>
    <div class="drift halftone pointer-events-none absolute inset-0 opacity-[0.05]" style="color: #e9eff6" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-5 pt-16 pb-20 md:grid-cols-[1.1fr_1fr] md:gap-14 md:pt-24 md:pb-28">
      <div class="stage-in">
        <span class="glass-dark inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs">
          <span class="led"></span>
          {site.funding} · {site.orgShort}
        </span>
        <h1 class="mt-7 text-[2.75rem] leading-[1.12] sm:text-6xl md:text-[4.5rem]">
          資料不落雲<br />
          <span style="color: #d9a441">AI 要落地</span>
        </h1>
        <p class="muted mt-8 max-w-md text-[15px] leading-loose">
          生成式 AI 的軟硬體整合，做在企業自己的機器上。myLLM 產學聯盟以獨立第三方角色評測模型效能，
          並把驗證過的模型帶進現場。
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a href="/services/" class="btn-primary">
            我們做什麼
            <Icon name="lucide:arrow-right" class="btn-arrow size-4" />
          </a>
          <a href="/services/#benchmark" class="btn-ghost" style="color: #e9eff6">
            <Icon name="lucide:activity" class="size-4" />
            看實測數據
          </a>
        </div>
      </div>

      <div class="float relative">
        <div class="absolute -inset-4 rounded-[2rem] opacity-60 blur-2xl" style="background: radial-gradient(60% 60% at 50% 50%, rgb(217 164 65 / 0.35), transparent)" aria-hidden="true"></div>
        <div class="frame relative" style="border-color: rgb(255 255 255 / 0.12)">
          <img
            src="/images/robot-comic.webp"
            alt="漫畫風格的機器人衝出畫面，象徵 AI 落地到實際場景"
            width="1024"
            height="1024"
            loading="eager"
            fetchpriority="high"
            class="block w-full"
          />
        </div>
        <div
          class="absolute -bottom-6 left-5 z-10 flex items-center gap-3 rounded-2xl px-4 py-3 sm:left-8"
          style="background: rgb(11 18 25 / 0.94); border: 1px solid rgb(255 255 255 / 0.12); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.1), 0 16px 40px -12px rgb(0 0 0 / 0.6)"
        >
          <Icon name="lucide:zap" class="size-5" style="color: #d9a441" />
          <div>
            <p class="reading text-lg leading-none" style="font-family: var(--font-display)">{speedup}×</p>
            <p class="muted mt-1 text-[11px]">4 bits 量化後的速度</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 評測裝置跑馬燈 */}
  <div class="marquee border-b py-5" style="border-color: var(--hairline); background: var(--surface-2)" aria-hidden="true">
    <div class="marquee-track gap-4 pr-4">
      {
        deviceTicker.map((d) => (
          <span class="pill shrink-0">
            <Icon name="lucide:cpu" class="size-3.5" style="color: var(--signal)" />
            {d.name}
            <span style="color: var(--ink-faint)">{d.tier}</span>
          </span>
        ))
      }
    </div>
  </div>

  {/* Bento：把最重要的幾件事拼成一塊 */}
  <section class="top-glow mx-auto max-w-6xl px-5 py-24">
    <div class="relative max-w-2xl">
      <h2 class="text-3xl leading-snug sm:text-4xl">{empowerment.headline}</h2>
      <p class="mt-5 text-[15px] leading-loose" style="color: var(--ink-soft)">{empowerment.note}</p>
    </div>

    <div class="bento relative mt-12">
      <article class="card spotlight md:col-span-4 md:row-span-2 flex flex-col justify-between p-8">
        <div class="grid gap-8 sm:grid-cols-2">
          {
            empowerment.contrast.map((c, i) => (
              <div>
                <span
                  class="grid size-11 place-items-center rounded-2xl"
                  style={i === 0 ? 'background: var(--surface-2)' : 'background: var(--signal); color: var(--signal-face)'}
                >
                  <Icon name={i === 0 ? 'lucide:user-round' : 'lucide:bot'} class="size-5" />
                </span>
                <h3 class="mt-5 text-2xl">{c.subject}</h3>
                <p class="mt-3 text-[15px] leading-loose" style="color: var(--ink-soft)">
                  {c.body}
                </p>
              </div>
            ))
          }
        </div>
        <div class="mt-10">
          <p class="text-sm" style="color: var(--ink-faint)">企業賦能員工要具備的能力</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {empowerment.abilities.map((a) => <li class="pill">{a}</li>)}
          </ul>
        </div>
      </article>

      <article class="card glow-border md:col-span-2 flex flex-col justify-between p-7">
        <div class="flex items-center gap-2 text-sm" style="color: var(--ink-faint)">
          <span class="led"></span>7B · 4 bits
        </div>
        <div>
          <p class="reading text-5xl" style="font-family: var(--font-display); color: var(--signal)">{seven.tokPerSec[0]}</p>
          <p class="mt-2 text-sm" style="color: var(--ink-soft)">每秒 token，比 16 bits 快 {speedup} 倍</p>
        </div>
      </article>

      <article class="card spotlight md:col-span-2 flex flex-col justify-between p-7">
        <Icon name="lucide:target" class="size-6" style="color: var(--signal)" />
        <div>
          <p class="reading text-5xl" style="font-family: var(--font-display)">{seven.mmlu[0]}%</p>
          <p class="mt-2 text-sm" style="color: var(--ink-soft)">MMLU 準確率，16 bits 為 {seven.mmlu[2]}%</p>
        </div>
      </article>

      <a href="/services/#benchmark" class="card panel-hover md:col-span-3 group overflow-hidden">
        <div class="overflow-hidden">
          <img src="/images/edge-devices.jpg" alt="六種嵌入式裝置並排陳列的評測平台" width="2876" height="832" loading="lazy" class="block w-full" />
        </div>
        <div class="flex items-center justify-between p-6">
          <div>
            <p class="text-base font-medium">六種嵌入式裝置的評測平台</p>
            <p class="mt-1 text-sm" style="color: var(--ink-soft)">從樹莓派到 Mac Studio，同一組測試</p>
          </div>
          <Icon name="lucide:arrow-up-right" class="icon-hover size-5 shrink-0" style="color: var(--signal)" />
        </div>
      </a>

      <a href="/newsletter/" class="card-soft panel-hover md:col-span-3 group flex flex-col justify-between p-7">
        <div class="flex items-center justify-between">
          <Icon name="lucide:newspaper" class="size-6" style="color: var(--signal)" />
          <Icon name="lucide:arrow-up-right" class="icon-hover size-5" style="color: var(--ink-faint)" />
        </div>
        <div class="mt-10">
          <p class="reading text-5xl" style="font-family: var(--font-display)">{totalArticles}</p>
          <p class="mt-2 text-sm" style="color: var(--ink-soft)">篇 AI 電子報文章，{issues.length} 期，自 2023.11 起每月發行</p>
        </div>
      </a>
    </div>
  </section>

  {/* 三個階段 */}
  <section style="background: var(--surface-2)">
    <div class="mx-auto max-w-6xl px-5 py-24">
      <h2 class="text-3xl sm:text-4xl">企業導入 LLM 的三個階段</h2>
      <div class="mt-12 grid gap-4 md:grid-cols-3">
        {
          services.map((s, i) => (
            <a href={`/services/#${s.id}`} class="card spotlight panel-hover group flex flex-col p-7">
              <div class="flex items-center justify-between">
                <span class="grid size-12 place-items-center rounded-2xl" style="background: var(--surface-2)">
                  <Icon name={s.icon} class="icon-hover size-6" style="color: var(--signal)" />
                </span>
                <span class="reading text-sm" style="color: var(--ink-faint)">
                  階段 {i + 1}
                </span>
              </div>
              <h3 class="mt-7 text-xl">{s.title}</h3>
              <p class="mt-3 text-sm leading-loose" style="color: var(--ink-soft)">
                {s.summary}
              </p>
              <span class="mt-auto flex items-center gap-1.5 pt-6 text-sm" style="color: var(--signal)">
                服務內容
                <Icon name="lucide:arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* Edge Landing 七項 */}
  <section class="mx-auto max-w-6xl px-5 py-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <h2 class="text-3xl sm:text-4xl">Edge Landing 七項落地服務</h2>
        <p class="mt-4 text-[15px]" style="color: var(--ink-soft)">模型在企業自己的環境裡執行，資料不必離開現場。</p>
      </div>
      <a href="/services/#edge-landing" class="link-line text-sm">
        全部服務細節
        <Icon name="lucide:arrow-up-right" class="size-3.5" />
      </a>
    </div>
    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        edgeLanding.map((item, i) => (
          <li class={i === 0 ? 'sm:col-span-2' : ''}>
            <a href={`/services/#${item.id}`} class="card spotlight panel-hover group flex h-full flex-col p-6">
              <span class="grid size-11 place-items-center rounded-2xl" style="background: var(--surface-2)">
                <Icon name={item.icon} class="icon-hover size-5" style="color: var(--signal)" />
              </span>
              <span class="mt-5 text-base font-medium">{item.title}</span>
              <span class="mt-2 text-sm leading-relaxed" style="color: var(--ink-soft)">
                {item.summary}
              </span>
              {item.device && (
                <span class="pill mt-auto self-start pt-1.5" style="margin-top: auto">
                  <Icon name="lucide:cpu" class="size-3.5" style="color: var(--signal)" />
                  {item.device.name}
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/* 電子報 */}
  <section style="background: var(--surface-2)">
    <div class="mx-auto max-w-6xl px-5 py-24">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="text-3xl sm:text-4xl">最新的 AI 電子報</h2>
        <a href="/newsletter/" class="link-line text-sm">
          瀏覽全部 {issues.length} 期
          <Icon name="lucide:arrow-up-right" class="size-3.5" />
        </a>
      </div>
      <ul class="mt-12 grid gap-4 md:grid-cols-3">
        {
          latest.map((issue) => (
            <li>
              <a href={`/newsletter/${issue.no}/`} class="card spotlight panel-hover group flex h-full flex-col p-7">
                <div class="flex items-center justify-between">
                  <span class="pill">
                    <Icon name="lucide:calendar" class="size-3.5" style="color: var(--signal)" />
                    {issue.date}
                  </span>
                  <span class="reading text-3xl" style="font-family: var(--font-display); color: var(--signal)">
                    {issue.no}
                  </span>
                </div>
                <p class="mt-7 text-[15px] leading-relaxed">{issue.articles[0]?.title}</p>
                <span class="mt-auto flex items-center gap-1.5 pt-6 text-sm" style="color: var(--ink-faint)">
                  {issue.articles.length} 篇文章
                  <Icon name="lucide:arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* 結尾 */}
  <section class="mx-auto max-w-6xl px-5 py-24">
    <div class="inverse relative overflow-hidden rounded-[2rem] px-8 py-16 sm:px-14">
      <div class="aurora" aria-hidden="true"></div>
      <div class="relative max-w-xl">
        <h2 class="text-3xl leading-snug sm:text-4xl">想知道貴公司的 AI 系統表現如何？</h2>
        <p class="muted mt-6 text-[15px] leading-loose">會員可取得專業諮詢與平台評測資源。</p>
        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a href="/membership/" class="btn-primary">
            成為聯盟會員
            <Icon name="lucide:arrow-right" class="btn-arrow size-4" />
          </a>
          <a href="/contact/" class="btn-ghost" style="color: #e9eff6">聯絡聯盟窗口</a>
        </div>
      </div>
    </div>
  </section>
</Base>
