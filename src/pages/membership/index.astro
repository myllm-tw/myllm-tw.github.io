---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { membership, site } from '../../config/site';
import { services } from '../../data/services';

if (!membership.fee || membership.benefits.length === 0) {
  console.warn(
    '[membership] 會員費用或權益尚未填寫，/membership/ 會少掉對應區塊。請在 src/config/site.ts 的 membership 補上。',
  );
}
---

<Base title="成為會員" description="加入 myLLM 產學聯盟，取得專業諮詢、平台評測與技術交流資源。">
  <PageHeader
    title="成為聯盟會員"
    lead={`${site.org}的 myLLM 產學聯盟提供三個方向的服務。會員可取得諮詢、評測與技術交流資源。`}
  />

  <section class="mx-auto max-w-5xl px-5 py-20">
    <div class="grid gap-16 lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-20">
      <div>
        <h2 class="text-2xl">會員可以取得什麼</h2>
        {
          membership.benefits.length > 0 ? (
            <ul class="mt-8 space-y-4">
              {membership.benefits.map((b) => (
                <li class="border-t pt-4 text-[15px] leading-loose" style="border-color: var(--rule); color: var(--ink-soft)">
                  {b}
                </li>
              ))}
            </ul>
          ) : (
            <div class="mt-8">
              <p class="max-w-xl text-[15px] leading-loose" style="color: var(--ink-soft)">
                聯盟目前提供以下三個方向的服務，會員可依需求與聯盟討論合作方式。
              </p>
              <dl class="mt-8">
                {services.map((s) => (
                  <div class="border-t py-5" style="border-color: var(--rule)">
                    <dt class="text-base font-medium">{s.title}</dt>
                    <dd class="mt-2 max-w-xl text-sm leading-loose" style="color: var(--ink-soft)">
                      {s.summary}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          )
        }
      </div>

      <div class="space-y-10 border-t pt-8 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8" style="border-color: var(--rule)">
        {
          membership.fee && (
            <div>
              <p class="text-sm" style="color: var(--ink-faint)">會員費用</p>
              <p class="reading mt-2 text-2xl" style="font-family: var(--font-display)">{membership.fee}</p>
            </div>
          )
        }
        {
          membership.eligibility && (
            <div>
              <p class="text-sm" style="color: var(--ink-faint)">入會資格</p>
              <p class="mt-2 text-sm leading-loose" style="color: var(--ink-soft)">{membership.eligibility}</p>
            </div>
          )
        }
        <div>
          <p class="text-sm" style="color: var(--ink-faint)">入會流程</p>
          <ol class="axis mt-5 space-y-6 text-sm" style="padding-left: 1.75rem">
            <li class="tick leading-relaxed">
              下載並填寫
              <a href={membership.applicationForm} style="color: var(--link)">會員申請表</a>
            </li>
            <li class="tick leading-relaxed">
              與<a href="/contact/" style="color: var(--link)">聯盟窗口</a>聯絡，確認服務需求
            </li>
            <li class="tick leading-relaxed">完成審核與繳費後取得會員資格</li>
          </ol>
        </div>
        <div>
          <p class="text-sm" style="color: var(--ink-faint)">使用條款</p>
          <p class="mt-2 text-sm leading-loose" style="color: var(--ink-soft)">
            加入會員即表示同意本聯盟的
            <a href="/membership/terms/" style="color: var(--link)">使用條款</a>，共十二章。
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
