---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { Icon } from 'astro-icon/components';
import issues from '../../data/newsletter.json';

export function getStaticPaths() {
  return issues.map((issue) => ({ params: { no: String(issue.no) }, props: { issue } }));
}

const { issue } = Astro.props;
const sorted = [...issues].sort((a, b) => a.no - b.no);
const index = sorted.findIndex((i) => i.no === issue.no);
const prev = sorted[index - 1];
const next = sorted[index + 1];
---

<Base
  title={`第 ${issue.no} 期電子報`}
  description={`myLLM AI 電子報第 ${issue.no} 期（${issue.date}），收錄 ${issue.articles.length} 篇文章。`}
>
  <PageHeader
    title={`第 ${issue.no} 期`}
    lead={`${issue.date} 發行，收錄 ${issue.articles.length} 篇文章。點任何一篇即可下載 PDF 全文。`}
  />

  <section class="mx-auto max-w-4xl px-5 py-20">
    <ol class="hairline-list">
      {
        issue.articles.map((article, i) => (
          <li class="hairline-row">
            <a href={article.pdf} class="grid items-baseline gap-x-6 gap-y-1 py-6 sm:grid-cols-[2.5rem_1fr_auto]">
              <span class="reading text-2xl" style="font-family: var(--font-display); color: var(--signal)">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="text-lg leading-relaxed" style="font-family: var(--font-display)">{article.title}</span>
              <span class="row-arrow inline-flex items-center gap-1.5 text-sm" style="color: var(--ink-faint)">
                <Icon name="lucide:download" class="size-4" />
                PDF
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    <nav class="grid-rules mt-16 grid-cols-3 text-sm">
      {
        prev ? (
          <a href={`/newsletter/${prev.no}/`} class="group flex flex-col gap-1 px-1 py-5">
            <span class="text-xs" style="color: var(--ink-faint)">上一期</span>
            <span class="inline-flex items-center gap-1.5">
              <Icon name="lucide:arrow-left" class="size-4 transition-transform group-hover:-translate-x-1" style="color: var(--signal)" />
              第 {prev.no} 期
            </span>
          </a>
        ) : (
          <span />
        )
      }
      <a href="/newsletter/" class="flex flex-col items-center justify-center gap-1 px-1 py-5 text-center">
        <span class="text-xs" style="color: var(--ink-faint)">全部</span>
        所有期數
      </a>
      {
        next ? (
          <a href={`/newsletter/${next.no}/`} class="group flex flex-col items-end gap-1 px-1 py-5 text-right">
            <span class="text-xs" style="color: var(--ink-faint)">下一期</span>
            <span class="inline-flex items-center gap-1.5">
              第 {next.no} 期
              <Icon name="lucide:arrow-right" class="size-4 transition-transform group-hover:translate-x-1" style="color: var(--signal)" />
            </span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>

    <p class="mt-10 text-xs leading-loose" style="color: var(--ink-faint)">
      這一期寄出時的原始版面保留在
      <a href={`/news/newsletter/newsletter-${issue.no}.html`} class="link-line">
        /news/newsletter/newsletter-{issue.no}.html
      </a>
    </p>
  </section>
</Base>
