---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import issues from '../../data/newsletter.json';

export function getStaticPaths() {
  return issues.map((issue) => ({
    params: { no: String(issue.no) },
    props: { issue },
  }));
}

const { issue } = Astro.props;
const sorted = [...issues].sort((a, b) => a.no - b.no);
const index = sorted.findIndex((i) => i.no === issue.no);
const prev = sorted[index - 1];
const next = sorted[index + 1];
---

<Base
  title={`第 ${issue.no} 期電子報`}
  description={`myLLM AI 電子報第 ${issue.no} 期（${issue.date}），收錄 ${issue.articles.length} 篇文章。`}
>
  <PageHeader
    title={`第 ${issue.no} 期`}
    titleEn={`Newsletter · ${issue.date}`}
    lead={`收錄 ${issue.articles.length} 篇文章。每篇都可以下載 PDF 全文。`}
  />

  <section class="mx-auto max-w-4xl px-4 py-14">
    <ul class="space-y-3">
      {
        issue.articles.map((article, i) => (
          <li>
            <a
              href={article.pdf}
              class="flex items-start gap-4 rounded-xl border p-5 transition-colors hover:border-current"
              style="border-color: var(--border); background: var(--surface)"
            >
              <span class="mt-0.5 text-sm font-bold tabular-nums" style="color: var(--ink-faint)">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="flex-1">
                <span class="block text-[15px] font-medium leading-relaxed">{article.title}</span>
                <span class="mt-1.5 block text-xs" style="color: var(--ink-faint)">
                  PDF 全文
                </span>
              </span>
              <svg
                class="mt-1 size-4 shrink-0"
                style="color: var(--accent)"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M12 3v12M7 12l5 5 5-5M5 21h14" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>

    <nav class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t pt-8" style="border-color: var(--border)">
      {
        prev ? (
          <a href={`/newsletter/${prev.no}/`} class="text-sm font-medium hover:underline" style="color: var(--accent)">
            ← 第 {prev.no} 期
          </a>
        ) : (
          <span />
        )
      }
      <a href="/newsletter/" class="text-sm font-medium hover:underline" style="color: var(--ink-muted)">
        所有期數
      </a>
      {
        next ? (
          <a href={`/newsletter/${next.no}/`} class="text-sm font-medium hover:underline" style="color: var(--accent)">
            第 {next.no} 期 →
          </a>
        ) : (
          <span />
        )
      }
    </nav>

    <p class="mt-8 text-xs leading-relaxed" style="color: var(--ink-faint)">
      這一期的原始電子報版面保留在
      <a href={`/news/newsletter/newsletter-${issue.no}.html`} class="underline">
        /news/newsletter/newsletter-{issue.no}.html
      </a>
      。
    </p>
  </section>
</Base>
