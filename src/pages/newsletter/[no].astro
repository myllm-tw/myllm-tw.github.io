---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { Icon } from 'astro-icon/components';
import issues from '../../data/newsletter.json';

export function getStaticPaths() {
  return issues.map((issue) => ({ params: { no: String(issue.no) }, props: { issue } }));
}

const { issue } = Astro.props;
const sorted = [...issues].sort((a, b) => a.no - b.no);
const index = sorted.findIndex((i) => i.no === issue.no);
const prev = sorted[index - 1];
const next = sorted[index + 1];
---

<Base
  title={`第 ${issue.no} 期電子報`}
  description={`myLLM AI 電子報第 ${issue.no} 期（${issue.date}），收錄 ${issue.articles.length} 篇文章。`}
>
  <PageHeader
    title={`第 ${issue.no} 期`}
    lead={`${issue.date} 發行，收錄 ${issue.articles.length} 篇文章。點任何一篇即可下載 PDF 全文。`}
  />

  <section class="top-glow mx-auto max-w-3xl px-5 py-20">
    <ul class="relative space-y-3">
      {
        issue.articles.map((article, i) => (
          <li>
            <a href={article.pdf} class="card spotlight panel-hover group flex items-center gap-5 p-5">
              <span
                class="reading grid size-10 shrink-0 place-items-center rounded-xl text-sm"
                style="background: var(--surface-2); color: var(--ink-faint)"
              >
                {i + 1}
              </span>
              <span class="flex-1 text-[15px] leading-relaxed">{article.title}</span>
              <span class="pill shrink-0 transition-colors group-hover:border-[var(--signal)]">
                <Icon name="lucide:download" class="size-3.5" style="color: var(--signal)" />
                PDF
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <nav class="mt-14 flex flex-wrap items-center justify-between gap-3">
      {
        prev ? (
          <a href={`/newsletter/${prev.no}/`} class="btn-ghost group">
            <Icon name="lucide:arrow-left" class="size-4 transition-transform group-hover:-translate-x-1" />
            第 {prev.no} 期
          </a>
        ) : (
          <span />
        )
      }
      <a href="/newsletter/" class="pill">
        <Icon name="lucide:layout-grid" class="size-3.5" style="color: var(--signal)" />
        所有期數
      </a>
      {
        next ? (
          <a href={`/newsletter/${next.no}/`} class="btn-ghost group">
            第 {next.no} 期
            <Icon name="lucide:arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
          </a>
        ) : (
          <span />
        )
      }
    </nav>

    <p class="mt-10 text-center text-xs leading-loose" style="color: var(--ink-faint)">
      這一期寄出時的原始版面保留在
      <a href={`/news/newsletter/newsletter-${issue.no}.html`} class="link-line">
        /news/newsletter/newsletter-{issue.no}.html
      </a>
    </p>
  </section>
</Base>
