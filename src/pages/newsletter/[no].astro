---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import issues from '../../data/newsletter.json';

export function getStaticPaths() {
  return issues.map((issue) => ({ params: { no: String(issue.no) }, props: { issue } }));
}

const { issue } = Astro.props;
const sorted = [...issues].sort((a, b) => a.no - b.no);
const index = sorted.findIndex((i) => i.no === issue.no);
const prev = sorted[index - 1];
const next = sorted[index + 1];
---

<Base
  title={`第 ${issue.no} 期電子報`}
  description={`myLLM AI 電子報第 ${issue.no} 期（${issue.date}），收錄 ${issue.articles.length} 篇文章。`}
>
  <PageHeader
    title={`第 ${issue.no} 期`}
    lead={`${issue.date} 發行，收錄 ${issue.articles.length} 篇文章。`}
  />

  <section class="mx-auto max-w-3xl px-5 py-16">
    <ul>
      {
        issue.articles.map((article, i) => (
          <li class="border-t" style="border-color: var(--rule)">
            <a href={article.pdf} class="flex items-baseline gap-5 py-5">
              <span class="reading w-6 shrink-0 text-sm" style="color: var(--ink-faint)">
                {i + 1}
              </span>
              <span class="flex-1 text-[15px] leading-relaxed">{article.title}</span>
              <span class="shrink-0 text-xs" style="color: var(--ink-faint)">PDF</span>
            </a>
          </li>
        ))
      }
    </ul>

    <nav
      class="mt-14 flex flex-wrap items-center justify-between gap-5 border-t pt-7 text-sm"
      style="border-color: var(--rule)"
    >
      {
        prev ? (
          <a href={`/newsletter/${prev.no}/`} style="color: var(--link)">
            第 {prev.no} 期
          </a>
        ) : (
          <span />
        )
      }
      <a href="/newsletter/" style="color: var(--ink-soft)">所有期數</a>
      {
        next ? (
          <a href={`/newsletter/${next.no}/`} style="color: var(--link)">
            第 {next.no} 期
          </a>
        ) : (
          <span />
        )
      }
    </nav>

    <p class="mt-10 text-xs leading-loose" style="color: var(--ink-faint)">
      這一期寄出時的原始版面保留在
      <a href={`/news/newsletter/newsletter-${issue.no}.html`} class="underline">
        /news/newsletter/newsletter-{issue.no}.html
      </a>
    </p>
  </section>
</Base>
