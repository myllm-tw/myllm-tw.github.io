---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import issues from '../../data/newsletter.json';

const totalArticles = issues.reduce((n, i) => n + i.articles.length, 0);
const byYear = new Map<string, typeof issues>();
for (const issue of issues) {
  const year = issue.date.slice(0, 4);
  byYear.set(year, [...(byYear.get(year) ?? []), issue]);
}
const years = [...byYear.keys()].sort().reverse();
---

<Base
  title="AI 電子報"
  description={`myLLM 產學聯盟自 2023 年 11 月起發行的 AI 電子報，共 ${issues.length} 期、${totalArticles} 篇文章。`}
>
  <PageHeader
    title="AI 電子報"
    lead="每月整理值得一看的 AI 工具、模型與產業動態。每一篇都有 PDF 全文。"
    reading={[
      { label: '期數', value: String(issues.length) },
      { label: '文章', value: String(totalArticles) },
      { label: '開始發行', value: '2023.11' },
    ]}
  />

  {
    years.map((year) => (
      <section class="mx-auto max-w-5xl px-5 py-14">
        <h2 class="reading text-xl" style="color: var(--ink-faint)">
          {year}
        </h2>
        <ul class="mt-6">
          {byYear.get(year)!.map((issue) => (
            <li class="border-t" style="border-color: var(--rule)">
              <a href={`/newsletter/${issue.no}/`} class="flex flex-wrap items-baseline gap-x-6 gap-y-1 py-5">
                <span class="reading w-10 text-lg" style="font-family: var(--font-display); color: var(--signal)">
                  {issue.no}
                </span>
                <span class="reading text-sm" style="color: var(--ink-faint)">
                  {issue.date}
                </span>
                <span class="min-w-0 flex-1 text-[15px]">{issue.articles[0]?.title}</span>
                <span class="reading text-sm" style="color: var(--ink-faint)">
                  {issue.articles.length} 篇
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
