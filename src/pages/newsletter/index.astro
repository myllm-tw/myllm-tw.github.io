---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { Icon } from 'astro-icon/components';
import issues from '../../data/newsletter.json';

const totalArticles = issues.reduce((n, i) => n + i.articles.length, 0);
const byYear = new Map<string, typeof issues>();
for (const issue of issues) {
  const year = issue.date.slice(0, 4);
  byYear.set(year, [...(byYear.get(year) ?? []), issue]);
}
const years = [...byYear.keys()].sort().reverse();
---

<Base
  title="AI 電子報"
  description={`myLLM 產學聯盟自 2023 年 11 月起發行的 AI 電子報，共 ${issues.length} 期、${totalArticles} 篇文章。`}
>
  <PageHeader
    title="AI 電子報"
    lead="每月整理值得一看的 AI 工具、模型與產業動態。每一篇都有 PDF 全文。"
    reading={[
      { label: '期數', value: String(issues.length) },
      { label: '文章', value: String(totalArticles) },
      { label: '開始發行', value: '2023.11' },
    ]}
  />

  {/* Hairline Index：年份為大標，每期一列 */}
  <div class="mx-auto max-w-6xl px-5 py-20">
    {
      years.map((year) => (
        <section class="grid gap-6 py-10 md:grid-cols-[9rem_1fr] md:gap-12">
          <h2 class="reading text-4xl md:sticky md:top-24 md:self-start" style="font-family: var(--font-display); color: var(--signal)">
            {year}
          </h2>
          <ul class="hairline-list">
            {byYear.get(year)!.map((issue) => (
              <li class="hairline-row">
                <a
                  href={`/newsletter/${issue.no}/`}
                  class="grid items-baseline gap-x-6 gap-y-1 py-5 sm:grid-cols-[4.5rem_4.5rem_1fr_4rem_1.5rem]"
                >
                  <span class="reading text-sm" style="color: var(--ink-faint)">
                    第 {issue.no} 期
                  </span>
                  <span class="reading text-sm" style="color: var(--ink-faint)">
                    {issue.date.slice(5)} 月
                  </span>
                  <span class="text-[15px] leading-relaxed">{issue.articles[0]?.title}</span>
                  <span class="reading text-sm" style="color: var(--ink-faint)">
                    {issue.articles.length} 篇
                  </span>
                  <Icon name="lucide:arrow-right" class="row-arrow hidden size-5 sm:block" style="color: var(--ink-faint)" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
