---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { Icon } from 'astro-icon/components';
import issues from '../../data/newsletter.json';

const totalArticles = issues.reduce((n, i) => n + i.articles.length, 0);
const byYear = new Map<string, typeof issues>();
for (const issue of issues) {
  const year = issue.date.slice(0, 4);
  byYear.set(year, [...(byYear.get(year) ?? []), issue]);
}
const years = [...byYear.keys()].sort().reverse();
---

<Base
  title="AI 電子報"
  description={`myLLM 產學聯盟自 2023 年 11 月起發行的 AI 電子報，共 ${issues.length} 期、${totalArticles} 篇文章。`}
>
  <PageHeader
    title="AI 電子報"
    lead="每月整理值得一看的 AI 工具、模型與產業動態。每一篇都有 PDF 全文。"
    reading={[
      { label: '期數', value: String(issues.length) },
      { label: '文章', value: String(totalArticles) },
      { label: '開始發行', value: '2023.11' },
    ]}
  />

  {
    years.map((year, yi) => (
      <section class={yi % 2 === 1 ? '' : 'top-glow'} style={yi % 2 === 1 ? 'background: var(--surface-2)' : ''}>
        <div class="relative mx-auto max-w-6xl px-5 py-20">
          <div class="flex items-center gap-4">
            <h2 class="reading text-3xl" style="font-family: var(--font-display)">
              {year}
            </h2>
            <span class="pill">{byYear.get(year)!.length} 期</span>
          </div>
          <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {byYear.get(year)!.map((issue) => (
              <li>
                <a href={`/newsletter/${issue.no}/`} class="card spotlight panel-hover group flex h-full flex-col p-6">
                  <div class="flex items-start justify-between gap-3">
                    <span class="pill">
                      <Icon name="lucide:calendar" class="size-3.5" style="color: var(--signal)" />
                      {issue.date}
                    </span>
                    <span class="reading text-3xl leading-none" style="font-family: var(--font-display); color: var(--signal)">
                      {issue.no}
                    </span>
                  </div>
                  <p class="mt-6 line-clamp-2 text-[15px] leading-relaxed">{issue.articles[0]?.title}</p>
                  <span class="mt-auto flex items-center justify-between pt-6 text-sm" style="color: var(--ink-faint)">
                    <span class="inline-flex items-center gap-1.5">
                      <Icon name="lucide:file-text" class="size-4" />
                      {issue.articles.length} 篇文章
                    </span>
                    <Icon name="lucide:arrow-right" class="size-4 transition-transform group-hover:translate-x-1" style="color: var(--signal)" />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }
</Base>
