---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { services, edgeLanding } from '../data/services';
---

<Base
  title="核心服務"
  description="LLM 生態圈交流、平台落地測試與評估、分析式與生成式 AI 平台設計，以及 Edge Landing 六項落地服務。"
>
  <PageHeader
    title="從知識交流到模型落地"
    lead="三項服務對應企業導入大型語言模型的先後階段。先讓知識流動，再驗證效能，最後設計能在現場運作的平台。"
  />

  <section class="mx-auto max-w-5xl px-5 py-20">
    <div class="axis space-y-20">
      {
        services.map((s, i) => (
          <article id={s.id} class="tick scroll-mt-24" data-major>
            <div class="flex items-baseline gap-4">
              <span class="reading text-sm" style="color: var(--signal)">
                {i + 1}
              </span>
              <h2 class="text-2xl">{s.title}</h2>
            </div>
            <p class="mt-5 max-w-2xl text-lg leading-relaxed">{s.summary}</p>
            <div class="mt-6 max-w-2xl space-y-5 text-[15px] leading-loose" style="color: var(--ink-soft)">
              {s.detail.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section id="edge-landing" class="scroll-mt-24 border-t" style="border-color: var(--rule); background: var(--panel)">
    <div class="mx-auto max-w-5xl px-5 py-20">
      <h2 class="text-2xl sm:text-3xl">Edge Landing</h2>
      <p class="mt-6 max-w-xl text-[15px] leading-loose" style="color: var(--ink-soft)">
        讓模型在企業自己的環境裡執行，資料不必離開現場。六項服務沒有先後，依需求選擇。
      </p>
      <dl class="mt-12 grid gap-x-12 sm:grid-cols-2">
        {
          edgeLanding.map((item) => (
            <div class="border-t py-6" style="border-color: var(--rule)">
              <dt class="text-base font-medium">{item.title}</dt>
              <dd class="mt-2 text-sm leading-loose" style="color: var(--ink-soft)">
                {item.description}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 py-20">
    <h2 class="max-w-xl text-2xl leading-snug sm:text-3xl">想知道哪一項適合貴公司？</h2>
    <p class="mt-6 max-w-xl text-[15px] leading-loose" style="color: var(--ink-soft)">
      會員可取得專業諮詢服務，由聯盟協助釐清需求與可行的導入方式。
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-8">
      <a
        href="/membership/"
        class="px-6 py-3 text-sm font-medium"
        style="background: var(--signal); color: var(--signal-face)"
      >
        成為聯盟會員
      </a>
      <a href="/contact/" class="border-b pb-0.5 text-sm" style="color: var(--link); border-color: var(--rule-strong)">
        聯絡聯盟窗口
      </a>
    </div>
  </section>
</Base>
